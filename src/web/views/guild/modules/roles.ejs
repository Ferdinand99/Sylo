<% var cfg = moduleConfig || {}; %>
<% var autoroles = Array.isArray(cfg.autoroles) ? cfg.autoroles : []; %>
<% var rrMsgs = Array.isArray(cfg.reactionMessages) ? cfg.reactionMessages : []; %>
<% var chName = function (id) { var c = channels.find(function (x) { return x.id === id; }); return c ? c.name : id; }; %>

<div class="rr-list-head">
  <h3 style="margin:0">Reaction roles</h3>
  <a class="btn btn-primary" href="/guilds/<%= guild.id %>/m/roles/rr/new">＋ New reaction role</a>
</div>

<% if (rrMsgs.length === 0) { %>
  <p class="muted small">None yet — create one to let members self-assign roles by reacting.</p>
<% } else { %>
  <% rrMsgs.forEach(function (rm) { %>
    <div class="cmd-override">
      <div class="cmd-override-head">
        <span>
          <strong><%= (rm.embed && rm.embed.title) || (rm.message || '').slice(0, 60) || 'Reaction role' %></strong>
          <span class="muted small">· #<%= chName(rm.channelId) %> · <%= (rm.pairs || []).length %> role(s) · <%= rm.style || 'reaction' %><% if ((rm.style || 'reaction') !== 'select') { %> · <%= rm.mode || 'default' %><% } %><%= rm.exclusive ? ' · exclusive' : '' %></span>
        </span>
        <span class="pill <%= rm.messageId ? 'on' : 'off' %>"><%= rm.messageId ? 'published' : 'draft' %></span>
      </div>
      <div class="btn-row">
        <a class="plugin-btn" href="/guilds/<%= guild.id %>/m/roles/rr/<%= rm.id %>">Edit</a>
        <form method="POST" action="/guilds/<%= guild.id %>/m/roles/rr/<%= rm.id %>/delete" style="display:inline">
          <button type="submit" class="danger" data-confirm="Delete this reaction-role set and its message?">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>

<hr class="sep" />

<h3 style="margin:4px 0">Autoroles on join</h3>
<p class="muted small">Given automatically when a member joins. Also editable on the <a href="/guilds/<%= guild.id %>/m/welcome">Welcome &amp; goodbye</a> page.</p>
<form method="POST" action="/guilds/<%= guild.id %>/m/roles/config" hx-post="/guilds/<%= guild.id %>/m/roles/config" hx-target="#module-config" hx-swap="outerHTML" class="stack" style="max-width:520px">
  <div class="role-picker" data-field="autoroles">
    <div class="role-chips" data-role-chips>
      <% autoroles.forEach(function (id) { var r = roles.find(function (x) { return x.id === id; }); %>
        <span class="role-chip" data-id="<%= id %>" data-name="<%= r ? r.name : id %>" data-color="">
          <span class="role-dot" style="background:var(--muted)"></span><%= r ? r.name : id %>
          <button type="button" class="role-chip-x" aria-label="Remove">&times;</button>
          <input type="hidden" name="autoroles" value="<%= id %>" />
        </span>
      <% }) %>
    </div>
    <select class="role-picker-add">
      <option value="">+ Add a role…</option>
      <% roles.filter(function (r) { return !autoroles.includes(r.id); }).forEach(function (r) { %>
        <option value="<%= r.id %>" data-name="<%= r.name %>"><%= r.name %></option>
      <% }) %>
    </select>
  </div>
  <div style="margin-top:10px"><button type="submit">Save autoroles</button></div>
</form>
