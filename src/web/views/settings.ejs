<%- include('partials/header', { title: 'Sylo — Bot Personalizer' }) %>

<h1 class="page-title">Bot Personalizer</h1>
<p class="muted">Change the bot's username, avatar, banner and activity. These are bot-wide — they apply in
  every server<% if (bot) { %> (currently <strong><%= bot.tag %></strong>)<% } %>.</p>

<% if (typeof m !== 'undefined' && m) { %>
  <div class="banner banner-flash <%= ok ? 'ok' : 'bad' %>"><%= m %></div>
<% } %>

<% if (!bot) { %>
  <section class="card"><p class="muted">The bot is not connected right now. Reload once it is online.</p></section>
<% } else { %>

<section class="card">
  <h2>Identity</h2>
  <form method="POST" action="/settings/identity" class="stack u-mw-lg">
    <div class="bp-identity">
      <div class="bp-avatar">
        <img src="<%= bot.avatar %>" alt="bot avatar" />
      </div>
      <div class="stack" style="flex:1;gap:8px">
        <label class="small">Avatar image URL <span class="muted">— https, PNG/JPG/GIF, ≤ 10 MB</span></label>
        <input type="url" name="avatarUrl" placeholder="https://…/avatar.png" />
        <label class="checkline"><input type="checkbox" name="resetAvatar" /> Reset avatar to the default Discord icon</label>
      </div>
    </div>

    <label class="small u-mt-2">Banner image URL <span class="muted">— optional; not all bots can set one</span></label>
    <input type="url" name="bannerUrl" placeholder="https://…/banner.png" />
    <% if (bot.banner) { %><img src="<%= bot.banner %>" alt="current banner" class="bp-banner" /><% } %>

    <label class="small u-mt-2">Username</label>
    <input type="text" name="username" maxlength="32" value="<%= bot.username %>" />
    <p class="muted small">Discord only allows about <strong>2 username changes per hour</strong>. Leave it as-is to skip.</p>

    <div class="u-mt-3"><button type="submit">Save identity</button></div>
  </form>
</section>

<% } %>

<section class="card">
  <h2>Status i aktywność</h2>
  <p class="muted small">
    Tekst widoczny pod nazwą bota na Discordzie. Zmienne <code>{servers}</code> i <code>{members}</code> pokazują liczbę serwerów i użytkowników. Wypełnij listę, aby bot losował teksty.
  </p>

  <form method="POST" action="/settings/presence" class="stack u-mw-lg">
    <label>Status dostępności</label>
    <select name="status">
      <% presenceStatuses.forEach(function (s) { %>
        <option value="<%= s %>" <%= s === presence.status ? 'selected' : '' %>>
          <%= ({ online: 'Online', idle: 'Idle', dnd: 'Do Not Disturb', invisible: 'Invisible' })[s] || s %>
        </option>
      <% }) %>
    </select>

    <label>Rodzaj aktywności</label>
    <select name="type">
      <% presenceTypes.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === presence.type ? 'selected' : '' %>><%= t %></option>
      <% }) %>
    </select>
    <p class="muted small">„Custom” wyświetla sam tekst. Pozostałe rodzaje dodają np. „Gra w” lub „Słucha”.</p>

    <label>Stały tekst (gdy lista losowych tekstów jest pusta)</label>
    <input type="text" name="text" maxlength="128" value="<%= presence.text %>" placeholder="e.g. over {servers} servers" />

    <label>Losowe teksty — każdy w osobnym wierszu</label>
    <textarea name="texts" rows="6" placeholder="serowa pizza&#10;robię nic, ale szybko&#10;liczę do trzech"><%= (presence.texts || []).join('\n') %></textarea>
    <p class="muted small">Maks. 100 tekstów po 128 znaków. Bot nie powtarza tego samego tekstu dwa razy z rzędu, gdy lista ma więcej niż jedną pozycję. Status jest wspólny dla wszystkich serwerów bota.</p>
    <label>Zmiana tekstu co (sekundy)</label>
    <input type="number" name="rotationSeconds" min="10" max="3600" step="10" value="<%= presence.rotationSeconds || 60 %>" />
    <div class="u-mt-3"><button type="submit">Zapisz status</button></div>
  </form>
</section>

<section class="card">
  <h2>Historia personalizacji bota</h2>
  <p class="muted small">Zmiany wykonane przez panel od włączenia historii. ID wskazuje zalogowanego użytkownika Discorda. „local-admin” oznacza panel bez logowania. Starsze zmiany nie są dostępne.</p>
  <% if (!history.length) { %><p class="muted">Brak zapisanych zmian.</p><% } else { %>
  <div style="overflow-x:auto"><table>
    <thead><tr><th>Czas</th><th>ID użytkownika</th><th>Operacja</th><th>Szczegóły</th></tr></thead>
    <tbody><% history.forEach(function(entry) { %><tr>
      <td><%= new Date(Number(entry.created_at)).toLocaleString('pl-PL', { timeZone: 'Europe/Warsaw' }) %></td>
      <td><code><%= entry.actor %></code></td><td><%= entry.label %></td><td><%= entry.detail %></td>
    </tr><% }) %></tbody>
  </table></div>
  <% } %>
</section>

<%- include('partials/footer') %>
