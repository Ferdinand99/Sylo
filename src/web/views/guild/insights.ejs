<%
  var S = Array.isArray(series) ? series : [];
  var unit = (typeof granularity !== 'undefined' && granularity === 'hour') ? 'hour' : 'day';
  var W = 600, H = 120, PAD = 4;
  var n = S.length || 1;
  var bandW = W / n;

  function niceMax(v) { return v <= 0 ? 1 : v; }

  function bars(key, cls) {
    var max = niceMax(Math.max.apply(null, S.map(function (d) { return d[key]; }).concat(0)));
    return S.map(function (d, i) {
      var h = (d[key] / max) * (H - PAD * 2);
      var x = i * bandW + Math.max(0.5, bandW * 0.12);
      var w = Math.max(1, bandW * 0.76);
      return '<rect class="' + cls + '" x="' + x.toFixed(1) + '" y="' + (H - PAD - h).toFixed(1) +
        '" width="' + w.toFixed(1) + '" height="' + Math.max(0, h).toFixed(1) + '" rx="1"/>';
    }).join('');
  }

  function line(key, keys, cls) {
    var max = niceMax(Math.max.apply(null, S.map(function (d) {
      return Math.max.apply(null, keys.map(function (k) { return d[k]; }));
    }).concat(0)));
    var pts = S.map(function (d, i) {
      var x = i * bandW + bandW / 2;
      var y = H - PAD - (d[key] / max) * (H - PAD * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    }).join(' ');
    return '<polyline class="' + cls + '" fill="none" points="' + pts + '"/>';
  }

  function growthLine() {
    var run = 0;
    var vals = S.map(function (d) { run += d.joins - d.leaves; return run; });
    var lo = Math.min.apply(null, vals.concat(0)), hi = Math.max.apply(null, vals.concat(0));
    var span = (hi - lo) || 1;
    var pts = vals.map(function (v, i) {
      var x = i * bandW + bandW / 2;
      var y = H - PAD - ((v - lo) / span) * (H - PAD * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    }).join(' ');
    return { pts: pts, end: vals.length ? vals[vals.length - 1] : 0 };
  }

  function fmtDuration(mins) {
    mins = Math.round(mins || 0);
    if (mins < 60) return mins + ' min';
    var h = Math.floor(mins / 60);
    return h.toLocaleString('en') + ' h' + (mins % 60 ? ' ' + (mins % 60) + ' m' : '');
  }

  var g = growthLine();
  var topMsgMax = insightsTopChannels.length ? Math.max.apply(null, insightsTopChannels.map(function (c) { return c.messages; })) : 1;
  var topVoiceMax = insightsTopVoice.length ? Math.max.apply(null, insightsTopVoice.map(function (c) { return c.minutes; })) : 1;
  var RANGES = [['24', 'Last 24 hours'], ['48', 'Last 48 hours'], ['7', 'Last 7 days'], ['30', 'Last 30 days'], ['90', 'Last 90 days']];
  var windowLabel = 'last ' + range + ' ' + unit + (range === 1 ? '' : 's');
  var perLabel = 'per ' + unit;
%>

<div class="ins-range">
  <% RANGES.forEach(function (r) { %>
    <a href="/guilds/<%= guild.id %>/insights?range=<%= r[0] %>" class="pill <%= String(range) === r[0] ? 'on' : '' %>"><%= r[1] %></a>
  <% }) %>
  <form method="POST" action="/guilds/<%= guild.id %>/insights/refresh" class="ins-refresh">
    <input type="hidden" name="range" value="<%= range %>" />
    <button type="submit" class="secondary">↻ Refresh now</button>
  </form>
</div>
<p class="muted small u-mt-1">Buffered activity is written every ~10 minutes; use <strong>Refresh now</strong> to pull the last few minutes immediately.</p>

<div class="ins-tiles">
  <div class="ins-tile"><span class="ins-n"><%= totals.messages.toLocaleString('en') %></span><span class="muted small">messages</span></div>
  <div class="ins-tile"><span class="ins-n"><%= totals.net >= 0 ? '+' : '' %><%= totals.net %></span><span class="muted small">net members</span></div>
  <div class="ins-tile"><span class="ins-n ins-ok"><%= totals.joins %></span><span class="muted small">joins</span></div>
  <div class="ins-tile"><span class="ins-n ins-bad"><%= totals.leaves %></span><span class="muted small">leaves</span></div>
  <div class="ins-tile"><span class="ins-n"><%= fmtDuration(totals.voiceMinutes) %></span><span class="muted small">in voice</span></div>
  <div class="ins-tile"><span class="ins-n"><%= totals.voicePeak %></span><span class="muted small">peak in voice</span></div>
</div>

<div class="ins-grid">
  <section class="card ins-chart">
    <h3>Messages <%= perLabel %></h3>
    <svg viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="none" role="img" aria-label="Messages <%= perLabel %>">
      <%- bars('messages', 'ins-bar-msg') %>
    </svg>
  </section>

  <section class="card ins-chart">
    <h3>Voice minutes <%= perLabel %></h3>
    <svg viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="none" role="img" aria-label="Voice minutes <%= perLabel %>">
      <%- bars('voiceMinutes', 'ins-bar-voice') %>
    </svg>
  </section>

  <section class="card ins-chart">
    <h3>Member growth <span class="muted small">(cumulative, <%= g.end >= 0 ? '+' : '' %><%= g.end %> over range)</span></h3>
    <svg viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="none" role="img" aria-label="Cumulative member growth">
      <polyline class="ins-line-grow" fill="none" points="<%= g.pts %>"/>
    </svg>
  </section>

  <section class="card ins-chart">
    <h3>Joins vs leaves</h3>
    <svg viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="none" role="img" aria-label="Joins versus leaves <%= perLabel %>">
      <%- line('joins', ['joins', 'leaves'], 'ins-line-join') %>
      <%- line('leaves', ['joins', 'leaves'], 'ins-line-leave') %>
    </svg>
    <p class="muted small"><span class="ins-key ins-ok">▮</span> joins &nbsp; <span class="ins-key ins-bad">▮</span> leaves</p>
  </section>

  <section class="card ins-chart">
    <h3>Top channels <span class="muted small">(<%= windowLabel %>)</span></h3>
    <% if (!insightsTopChannels.length) { %>
      <p class="empty">No message activity recorded yet.</p>
    <% } else { %>
      <ul class="ins-bars">
        <% insightsTopChannels.forEach(function (c) { %>
          <li>
            <span class="ins-bar-label">#<%= c.name %></span>
            <span class="ins-bar-track"><span class="ins-bar-fill" style="width: <%= Math.max(3, (c.messages / topMsgMax) * 100).toFixed(1) %>%"></span></span>
            <span class="ins-bar-val muted"><%= c.messages.toLocaleString('en') %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card ins-chart">
    <h3>Top voice channels <span class="muted small">(<%= windowLabel %>)</span></h3>
    <% if (!insightsTopVoice.length) { %>
      <p class="empty">No voice activity recorded yet.</p>
    <% } else { %>
      <ul class="ins-bars">
        <% insightsTopVoice.forEach(function (c) { %>
          <li>
            <span class="ins-bar-label"><%= c.name %></span>
            <span class="ins-bar-track"><span class="ins-bar-fill ins-bar-fill-voice" style="width: <%= Math.max(3, (c.minutes / topVoiceMax) * 100).toFixed(1) %>%"></span></span>
            <span class="ins-bar-val muted"><%= fmtDuration(c.minutes) %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
