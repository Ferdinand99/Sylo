<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= guild.name %> — Economy leaderboard</title>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/public.css" />
</head>
<body>
  <main class="lb-wrap">
    <div class="pub-brand"><img src="/favicon.svg" alt="" width="28" height="28" /><span>Sylo</span></div>
    <header class="lb-head">
      <% if (guild.icon) { %><img class="lb-guild-icon" src="<%= guild.icon %>" alt="" /><% } %>
      <div>
        <h1 class="page-title"><%= guild.name %></h1>
        <p class="muted">Richest members · <%= total %> member<%= total === 1 ? '' : 's' %> with an account</p>
      </div>
    </header>

    <% if (members.length === 0) { %>
      <div class="card"><p class="muted">Nobody has any money yet.</p></div>
    <% } else { %>
      <ol class="lb-list">
        <% members.forEach(function (m) { %>
          <li class="lb-row<%= m.rank <= 3 ? ' lb-top' : '' %>">
            <span class="lb-rank">#<%= m.rank %></span>
            <% if (m.avatar) { %><img class="lb-avatar" src="<%= m.avatar %>" alt="" /><% } else { %><span class="lb-avatar lb-avatar-blank"></span><% } %>
            <div class="lb-main">
              <div class="lb-name<%= m.left ? ' muted' : '' %>"><%= m.name %></div>
            </div>
            <div class="lb-stats">
              <span class="lb-level"><%= currency.emoji %> <%= m.total %> <%= currency.name %></span>
            </div>
          </li>
        <% }) %>
      </ol>

      <% if (pages > 1) { %>
        <nav class="lb-pager">
          <% if (page > 1) { %><a href="?page=<%= page - 1 %>">&larr; Prev</a><% } else { %><span class="lb-pager-off">&larr; Prev</span><% } %>
          <span class="muted">Page <%= page %> of <%= pages %></span>
          <% if (page < pages) { %><a href="?page=<%= page + 1 %>">Next &rarr;</a><% } else { %><span class="lb-pager-off">Next &rarr;</span><% } %>
        </nav>
      <% } %>
    <% } %>

    <p class="lb-foot muted small">Powered by Sylo</p>
  </main>
</body>
</html>
