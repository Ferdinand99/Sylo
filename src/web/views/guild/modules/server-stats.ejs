<% var cfg = moduleConfig || {}; var list = Array.isArray(cfg.channels) ? cfg.channels : []; %>

<p class="muted small">
  Pick a <strong>voice channel</strong> (make one, lock it so nobody can join) and Sylo renames it to
  show a live count. Use <code>{count}</code> in the name, e.g. <code>Members: {count}</code>.
  Sylo needs <strong>Manage Channels</strong> on each one. Discord rate-limits renames to about 2 per
  10 minutes per channel, so 5 minutes is the fastest that works reliably — and a channel is only
  renamed when its number actually changes.
</p>

<% if (guild == null || voiceChannels.length === 0) { %>
  <p class="warn-text small">This server has no voice channels — create one first.</p>
<% } %>

<form method="POST" action="/guilds/<%= guild.id %>/m/server-stats/config" hx-post="/guilds/<%= guild.id %>/m/server-stats/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-xl">
  <div id="ss-rows">
    <% (list.length ? list : [{ channelId: '', type: 'members', template: 'Members: {count}' }]).forEach(function (s) { %>
      <div class="row-form">
        <select name="ss_channel" style="min-width:180px">
          <option value="">— voice channel —</option>
          <% voiceChannels.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= c.id === s.channelId ? 'selected' : '' %>>🔊 <%= c.name %></option>
          <% }) %>
        </select>
        <select class="u-w-field" name="ss_type">
          <% statTypes.forEach(function (t) { %>
            <option value="<%= t[0] %>" <%= t[0] === s.type ? 'selected' : '' %>><%= t[1] %></option>
          <% }) %>
        </select>
        <input type="text" name="ss_template" class="grow" placeholder="Members: {count}" value="<%= s.template || '' %>" />
        <button type="button" class="link-btn" onclick="this.closest('.row-form').remove()">remove</button>
      </div>
    <% }) %>
  </div>
  <div><button type="button" class="secondary" id="ss-add">+ Add stat channel</button></div>

  <label class="small u-mt-3">Refresh every (minutes)</label>
  <input class="u-w-num" type="number" name="refreshMinutes" min="5" max="60" step="1"
    value="<%= (cfg.refreshMinutes != null ? cfg.refreshMinutes : 10) %>" />
  <span class="muted small">5–60. Lower is more current but closer to Discord's rename limit.</span>

  <div class="u-mt-3"><button type="submit">Save</button></div>
</form>

<template id="ss-template">
  <div class="row-form">
    <select name="ss_channel" style="min-width:180px">
      <option value="">— voice channel —</option>
      <% voiceChannels.forEach(function (c) { %><option value="<%= c.id %>">🔊 <%= c.name %></option><% }) %>
    </select>
    <select class="u-w-field" name="ss_type">
      <% statTypes.forEach(function (t) { %><option value="<%= t[0] %>"><%= t[1] %></option><% }) %>
    </select>
    <input type="text" name="ss_template" class="grow" placeholder="Members: {count}" />
    <button type="button" class="link-btn" onclick="this.closest('.row-form').remove()">remove</button>
  </div>
</template>
<script>
  document.getElementById('ss-add')?.addEventListener('click', () => {
    document.getElementById('ss-rows').appendChild(document.getElementById('ss-template').content.cloneNode(true));
  });
</script>
