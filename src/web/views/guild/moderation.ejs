<% var ACTION_LABEL = { warn: 'Warn', note: 'Note', timeout: 'Timeout', untimeout: 'Timeout lifted', kick: 'Kick', ban: 'Ban', unban: 'Unban' }; %>
<h2>Infractions <span class="muted">(<%= caseShown %><%= caseTotal > caseShown ? ` of ${caseTotal}` : '' %>)</span></h2>

<form method="POST" action="/guilds/<%= guild.id %>/warnings" class="row-form">
  <input type="text" name="userId" placeholder="User ID or @mention" required />
  <input type="text" name="reason" placeholder="Reason" maxlength="400" required class="grow" />
  <button type="submit">Add warning</button>
</form>
<form method="POST" action="/guilds/<%= guild.id %>/cases/reason" class="row-form">
  <input type="number" name="caseNumber" placeholder="Case #" min="1" required class="u-w-field-sm" />
  <input type="text" name="reason" placeholder="New reason" maxlength="1000" required class="grow" />
  <button type="submit">Edit reason</button>
</form>
<form method="POST" action="/guilds/<%= guild.id %>/warnings/clear" class="row-form"
      data-confirm="Delete every warning for that member?">
  <input type="text" name="userId" placeholder="User ID or @mention" required />
  <button type="submit" class="danger">Clear warnings for user</button>
</form>
<p class="muted small">
  Every moderation action (warn, note, timeout, kick, ban, …) lands here as a numbered case.
  In Discord: <code>/history @user</code>, <code>/case view #</code>, <code>/case reason # …</code>,
  <code>/case delete #</code>, <code>/case note @user …</code>.
</p>

<% if (cases.length === 0) { %>
  <p class="muted">No cases recorded in this server.</p>
<% } else { %>
  <table>
    <thead><tr><th>#</th><th>Type</th><th>User</th><th>Moderator</th><th>Reason</th><th>When</th><th></th></tr></thead>
    <tbody>
      <% cases.forEach(function (c) { %>
        <tr<%= c.active ? '' : ' class="muted"' %>>
          <td>#<%= c.caseNumber %></td>
          <td><%= ACTION_LABEL[c.action] || c.action %><%= c.detail ? ' · ' + c.detail : '' %><%= c.active ? '' : ' · deleted' %></td>
          <td><%= c.user %> <span class="muted mono"><%= c.userId %></span></td>
          <td><%= c.moderator %></td>
          <td><%= c.reason %></td>
          <td class="muted"><%= c.ago %></td>
          <td class="num">
            <% if (c.active) { %>
              <form class="u-inline" method="POST"
                    action="/guilds/<%= guild.id %>/cases/<%= c.caseNumber %>/delete"
                    data-confirm="Delete case #<%= c.caseNumber %>? (kept for audit, hidden from /history)">
                <button type="submit" class="link-btn">delete</button>
              </form>
            <% } else { %>
              <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/cases/<%= c.caseNumber %>/restore">
                <button type="submit" class="link-btn">restore</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p class="muted small">Deleting is soft — the case stays for audit but drops out of <code>/history</code> and the warn count.</p>
<% } %>

<h2 class="u-mt-6">Bans <span class="muted">(<%= bansShown %><%= bansTotal > bansShown ? ` of ${bansTotal}, first ${banLimit}` : '' %>)</span></h2>
<% if (bansError) { %>
  <p class="warn-text">⚠️ <%= bansError %></p>
<% } else if (bans.length === 0) { %>
  <p class="muted">No active bans in this server.</p>
<% } else { %>
  <table>
    <thead><tr><th>User</th><th>ID</th><th>Reason</th><th></th></tr></thead>
    <tbody>
      <% bans.forEach(function (b) { %>
        <tr>
          <td><%= b.tag %></td>
          <td class="mono"><%= b.id %></td>
          <td><%= b.reason %></td>
          <td class="num">
            <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/unban" data-confirm="Unban <%= b.tag %>?">
              <input type="hidden" name="userId" value="<%= b.id %>" />
              <button type="submit" class="link-btn">unban</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2 class="u-mt-6">Channel locks</h2>
<p class="muted small">
  A lock denies @everyone the send-message permissions on a channel; unlocking restores the exact
  overwrite that was there before. Also available as <code>/lock</code>, <code>/unlock</code> and
  <code>/lockdown</code>.
</p>
<div class="row-form">
  <% if (lockdownActive) { %>
    <form method="POST" action="/guilds/<%= guild.id %>/moderation/unlock-all"
          data-confirm="End the lockdown and unlock every channel it locked?">
      <button type="submit">End lockdown</button>
    </form>
  <% } else { %>
    <form method="POST" action="/guilds/<%= guild.id %>/moderation/lock-all"
          data-confirm="Lock every text channel in this server?">
      <button type="submit" class="danger">Lock all channels</button>
    </form>
  <% } %>
</div>
<% if (channelLocks.length === 0) { %>
  <p class="muted">No channels are locked.</p>
<% } else { %>
  <table>
    <thead><tr><th>Channel</th><th>By</th><th>When</th><th>Via</th><th></th></tr></thead>
    <tbody>
      <% channelLocks.forEach(function (l) { %>
        <tr>
          <td><%= l.name ? '#' + l.name : '(deleted)' %> <span class="muted mono"><%= l.channelId %></span></td>
          <td><%= l.lockedBy %></td>
          <td class="muted"><%= l.ago %></td>
          <td class="muted"><%= l.lockdown ? 'lockdown' : '/lock' %></td>
          <td class="num">
            <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/moderation/unlock-channel">
              <input type="hidden" name="channelId" value="<%= l.channelId %>" />
              <button type="submit" class="link-btn">unlock</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2 class="u-mt-6">Scheduled temporary bans</h2>
<% if (tempBans.length === 0) { %>
  <p class="muted">No temporary bans are pending. Use <code>/ban duration:…</code> to set one.</p>
<% } else { %>
  <table>
    <thead><tr><th>User</th><th>ID</th><th>Reason</th><th>Unbans in</th><th></th></tr></thead>
    <tbody>
      <% tempBans.forEach(function (t) { %>
        <tr>
          <td><%= t.tag %></td>
          <td class="mono"><%= t.userId %></td>
          <td><%= t.reason %></td>
          <td class="muted"><%= t.remaining %></td>
          <td class="num">
            <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/unban"
                  data-confirm="Lift the ban on <%= t.tag %> now?">
              <input type="hidden" name="userId" value="<%= t.userId %>" />
              <button type="submit" class="link-btn">lift now</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
