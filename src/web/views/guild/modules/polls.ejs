<% var cfg = moduleConfig || {}; %>
<% var mode = cfg.voteRoleMode === 'deny' ? 'deny' : 'allow'; %>
<% var voteRoles = Array.isArray(cfg.voteRoles) ? cfg.voteRoles : []; %>
<% var pm = cfg.pollMessage || {}; %>
<% var rm = cfg.resultsMessage || {}; %>
<% var LETTERS = ['🇦','🇧','🇨','🇩','🇪','🇫','🇬','🇭','🇮','🇯','🇰','🇱','🇲','🇳','🇴','🇵','🇶','🇷','🇸','🇹']; %>
<%
  var PM_BODY = '<div class="poll-body">' +
    '<div class="poll-body-q">{question}</div>' +
    '<div>🇦&nbsp; First option</div><div>🇧&nbsp; Second option</div><div>🇨&nbsp; …</div>' +
    '<div class="muted small u-mt-2">Sylo fills the question &amp; choices here</div>' +
    '</div>';
  var RM_BODY = '<div class="poll-body">' +
    '<div class="poll-body-q">{question}</div>' +
    '<div>🇦&nbsp; <b>First option</b><br>██████░░░░  60.0% · 6 votes</div>' +
    '<div>🇧&nbsp; <b>Second option</b><br>████░░░░░░  40.0% · 4 votes</div>' +
    '<div class="muted small u-mt-2">Sylo fills the results here</div>' +
    '</div>';
  var EMBED_OPTS = { content: true, author: false, description: false, fields: false, thumb: false, footerIcon: false, footerKey: 'footer', defaultColor: '#5b7cfa' };
%>

<p class="muted small">
  Members create polls with <code>/poll</code> and vote by reacting with the letter of their choice.
  A poll closes on its timer, when it hits its vote cap, or when someone runs <code>/poll-end</code>.
</p>

<section class="card">
  <h3 class="u-m0 u-mb-2">Commands</h3>
  <ul class="muted small u-list">
    <li><code>/poll question:… choices:A | B | C</code> — plus optional <code>duration:</code> (e.g. <code>2h</code>),
      <code>multiple:</code> (allow more than one vote) and <code>max_votes:</code>.</li>
    <li><code>/poll-end [message]</code> — closes the latest poll in the channel (or a specific one) and posts results.
      Creator or Manage Messages only.</li>
  </ul>
  <p class="small u-m0 u-mt-2">Votes are cast with these reactions:
    <span style="letter-spacing:2px"><% LETTERS.forEach(function (l) { %><%= l %><% }) %></span>
  </p>
</section>

<form method="POST" action="/guilds/<%= guild.id %>/m/polls/config" id="polls-form" class="stack u-mw-lg"
      hx-post="/guilds/<%= guild.id %>/m/polls/config" hx-target="#module-config" hx-swap="outerHTML">
  <input type="hidden" name="pm_json" id="pm-json" />
  <input type="hidden" name="rm_json" id="rm-json" />

  <section class="card stack">
    <h3 class="u-m0">Who can vote</h3>
    <select class="u-mw-sm" name="voteRoleMode">
      <option value="allow" <%= mode !== 'deny' ? 'selected' : '' %>>Everyone except the roles below</option>
      <option value="deny" <%= mode === 'deny' ? 'selected' : '' %>>Only members with a role below</option>
    </select>
    <%- include('../../partials/chip-picker', { field: 'voteRoles', kind: 'role', items: roles, selected: voteRoles }) %>
    <p class="muted small">Leave empty to let everyone vote. Disallowed reactions are removed automatically.</p>
  </section>

  <section class="card">
    <h3 class="u-m0">Polls message</h3>
    <p class="muted small">How a live poll looks. Click a field to edit it; Sylo fills the greyed-out body.</p>
    <%- include('../../partials/embed-editor', Object.assign({
      hidden: 'pm_json', spec: pm, fixedBody: PM_BODY,
      ph: { title: '📊 {question}', footer: '{ends} · {mode}' },
      vars: [
        { token: '{question}', label: 'question' },
        { token: '{choices}', label: 'choices' },
        { token: '{ends}', label: 'ends' },
        { token: '{mode}', label: 'mode' },
      ],
    }, EMBED_OPTS)) %>
  </section>

  <section class="card">
    <h3 class="u-m0">Results message</h3>
    <p class="muted small">Posted when a poll closes.</p>
    <%- include('../../partials/embed-editor', Object.assign({
      hidden: 'rm_json', spec: rm, fixedBody: RM_BODY,
      ph: { title: '📊 Results — {question}', footer: 'Winner: {winner} · {total} total votes' },
      vars: [
        { token: '{question}', label: 'question' },
        { token: '{results}', label: 'results' },
        { token: '{total}', label: 'total' },
        { token: '{winner}', label: 'winner' },
        { token: '{mode}', label: 'mode' },
      ],
    }, EMBED_OPTS)) %>
  </section>

  <div><button type="submit">Save</button></div>
</form>
