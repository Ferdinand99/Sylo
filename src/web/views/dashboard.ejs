<%- include('partials/header', { title: 'Sylo — Dashboard' }) %>

<section class="grid">
  <div class="card status <%= ready ? 'ok' : 'bad' %>">
    <h2>Bot</h2>
    <p class="big"><%= ready ? 'Online' : 'Offline' %></p>
    <p class="muted"><%= botTag ? botTag : 'not connected' %><% if (typeof syloVersion !== 'undefined' && syloVersion) { %> &middot; v<%= syloVersion %><% } %></p>
  </div>
  <div class="card">
    <h2>Servers</h2>
    <p class="big"><%= guildCount %></p>
    <p class="muted"><%= memberReach.toLocaleString('en') %> members reached</p>
  </div>
  <div class="card">
    <h2>Uptime</h2>
    <p class="big"><%= uptime %></p>
    <p class="muted">gateway ping <%= gatewayPing === null ? '—' : gatewayPing + ' ms' %></p>
  </div>
</section>

<% if (lastError) { %>
  <section class="card warn">
    <h2>Last error <span class="muted">(<%= lastErrorAgo %>)</span></h2>
    <pre><%= lastError.message %></pre>
  </section>
<% } %>

<section class="grid">
  <div class="card">
    <h2>Open tickets</h2>
    <p class="big"><%= stats.openTickets %></p>
    <p class="muted"><%= stats.ticketsTotal %> all-time</p>
  </div>
  <div class="card">
    <h2>Warnings</h2>
    <p class="big"><%= stats.warningsTotal %></p>
    <p class="muted"><%= stats.warningsWeek %> in the last 7 days</p>
  </div>
  <div class="card">
    <h2>Composed messages</h2>
    <p class="big"><%= stats.composedTotal %></p>
    <p class="muted">sent via Message Creator</p>
  </div>
  <div class="card">
    <h2>Cached stat lookups</h2>
    <p class="big"><%= stats.cachedLookups %></p>
    <p class="muted">Battlefield player queries</p>
  </div>
</section>

<section class="card">
  <h2>Module adoption</h2>
  <% if (modules.length === 0) { %>
    <p class="muted">No modules enabled yet — open a server from the switcher above and turn some on.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Module</th><th class="num">Servers</th></tr></thead>
      <tbody>
        <% modules.forEach(function (m) { %>
          <tr>
            <td><%= m.icon %> <%= m.name %></td>
            <td class="num"><%= m.guilds %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="card">
  <h2>Recently queried stats</h2>
  <% if (recent.length === 0) { %>
    <p class="muted">Nothing cached yet — run <code>/stats battlefield</code> in Discord.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Game</th><th>Title</th><th>Player</th><th>Platform</th><th>When</th></tr></thead>
      <tbody>
        <% recent.forEach(function (r) { %>
          <tr>
            <td><%= r.game %></td>
            <td><%= r.title %></td>
            <td><%= r.username %></td>
            <td><%= r.platform %></td>
            <td class="muted"><%= r.ago %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('partials/footer') %>
