<% var cfg = moduleConfig || {}; %>

<p class="muted small">
  Epic Games Store and Steam giveaways (via GamerPower) are checked hourly without API keys.
  Steam announcements include permanent claims; free weekends, demos and third-party key tasks are skipped.
  Other stores require an <code>ITAD_API_KEY</code>.
  DLC is filtered out of announcements; <code>/freegames dlc:true</code> shows free DLC on demand.
</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/free-games/config"
      hx-post="/guilds/<%= guild.id %>/m/free-games/config" hx-target="#module-config" hx-swap="outerHTML"
      class="stack u-mw-lg">
  <label>Announcement channel</label>
  <select name="channelId" required>
    <option value="">— select —</option>
    <% channels.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= c.id === (cfg.channelId || '') ? 'selected' : '' %>>#<%= c.name %></option>
    <% }) %>
  </select>

  <label class="u-mt-2">Ping role <span class="muted small">— optional</span></label>
  <select name="roleId">
    <option value="">— none —</option>
    <% roles.forEach(function (r) { %>
      <option value="<%= r.id %>" <%= r.id === (cfg.roleId || '') ? 'selected' : '' %>><%= r.name %></option>
    <% }) %>
  </select>

  <div class="u-mt-3"><button type="submit">Save</button></div>
</form>

<p class="muted small u-mt-3">Sylo needs View Channel / Send Messages / Embed Links in that channel.</p>
