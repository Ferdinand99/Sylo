<form method="POST" action="/guilds/<%= guild.id %>/m/logging/config"
      hx-post="/guilds/<%= guild.id %>/m/logging/config"
      hx-target="<%= typeof fragTarget !== 'undefined' ? fragTarget : '#module-config' %>"
      hx-swap="<%= typeof fragSwap !== 'undefined' ? fragSwap : 'outerHTML' %>"
      class="stack u-mw-lg">
  <label>Log channel</label>
  <select name="channel">
    <option value="">— none —</option>
    <% channels.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= c.id === (moduleConfig.channel || '') ? 'selected' : '' %>>#<%= c.name %></option>
    <% }) %>
  </select>

  <label class="u-mt-2">Events to log</label>
  <div class="check-grid">
    <% logEvents.forEach(function (pair) { var key = pair[0], name = pair[1]; %>
      <label class="check">
        <input type="checkbox" name="ev_<%= key %>" <%= (moduleConfig.events && moduleConfig.events[key]) ? 'checked' : '' %> />
        <%= name %>
      </label>
    <% }) %>
  </div>

  <div><button type="submit">Save</button></div>
</form>
