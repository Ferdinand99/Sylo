<% var cfg = moduleConfig || {}; var hubs = Array.isArray(cfg.hubs) ? cfg.hubs : []; %>
<% var vcName = function (id) { var c = (voiceChannels || []).find(function (x) { return x.id === id; }); return c ? c.name : id; }; %>

<p class="muted small">
  A <strong>hub</strong> is a "Join to create" voice channel. When a member joins it, Sylo makes them a
  personal voice channel (optionally with a paired text channel), moves them in, and cleans it up after
  everyone leaves. Owners and voice moderators control it with the <code>/voice-*</code> commands.
  Sylo needs <strong>Manage Channels</strong> and <strong>Move Members</strong>.
</p>

<% if ((voiceChannels || []).length === 0) { %>
  <div class="banner bad">This server has no voice channels — create the hub channel in Discord first.</div>
<% } %>

<div class="rr-list-head">
  <h3 class="u-m0">Your hubs <span class="muted small"><%= hubs.length %> / 25</span></h3>
  <a class="btn btn-primary" href="/guilds/<%= guild.id %>/m/temp-voice/hub/new">＋ New hub</a>
</div>

<% if (hubs.length === 0) { %>
  <p class="muted small">No hubs yet — create one to enable "join to create" voice channels.</p>
<% } else { %>
  <% hubs.forEach(function (h) { %>
    <div class="cmd-override">
      <div class="cmd-override-head">
        <span>
          <strong>🔊 <%= vcName(h.hubChannelId) %></strong>
          <span class="muted small">
            · <%= h.userLimit ? (h.userLimit + ' max') : 'no limit' %>
            · <%= h.keepAliveMinutes < 0 ? 'never deleted' : (h.keepAliveMinutes === 0 ? 'delete when empty' : ('keep ' + h.keepAliveMinutes + 'm')) %>
            <% if (h.textChannel && h.textChannel.enabled) { %> · text channel<% } %>
          </span>
        </span>
      </div>
      <div class="btn-row">
        <a class="plugin-btn" href="/guilds/<%= guild.id %>/m/temp-voice/hub/<%= h.id %>">Edit</a>
        <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/m/temp-voice/hub/<%= h.id %>/delete">
          <button type="submit" class="danger" data-confirm="Delete this hub? Existing temp channels stay until empty.">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>

<hr class="sep" />
<h3 class="u-my-1">Commands</h3>
<p class="muted small">Available to the channel owner and voice moderators. Restrict them per server on the
  <a href="/guilds/<%= guild.id %>/commands">Commands</a> page.</p>
<ul class="muted small" style="columns:2; margin:0; padding-left:18px; line-height:1.8">
  <li><code>/voice-lock</code> · <code>/voice-unlock</code></li>
  <li><code>/voice-hide</code> · <code>/voice-reveal</code></li>
  <li><code>/voice-limit</code> · <code>/voice-rename</code></li>
  <li><code>/voice-kick</code> · <code>/voice-ban</code> · <code>/voice-unban</code></li>
  <li><code>/voice-claim</code> · <code>/voice-transfer</code> · <code>/voice-owner</code></li>
  <li><code>/voice-clean</code> <span class="muted">(mods)</span></li>
</ul>
