<% var cfg = moduleConfig || {}; var cmds = Array.isArray(cfg.commands) ? cfg.commands : []; %>
<% var chName = function (id) { var c = channels.find(function (x) { return x.id === id; }); return c ? c.name : id; }; %>
<%
  var actionLabel = function (a) {
    if (a.type === 'reply') return a.private ? 'private reply' : 'reply';
    if (a.type === 'send') return 'post to #' + chName(a.channelId);
    if (a.type === 'add-role') return 'add a role';
    if (a.type === 'remove-role') return 'remove a role';
    return a.type;
  };
%>

<p class="muted small">
  Each command is a <code>/slash</code> command that runs an ordered list of actions —
  reply in the channel, post to another channel, or add / remove a role. Commands sync to
  Discord on save. Placeholders: <% ccPlaceholders.forEach(function (p) { %><code><%= p %></code> <% }) %>
  (<code>{args}</code> becomes a <code>text:</code> option).
</p>

<div class="rr-list-head">
  <h3 class="u-m0">Your commands <span class="muted small"><%= cmds.length %> / 200</span></h3>
  <a class="btn btn-primary" href="/guilds/<%= guild.id %>/m/custom-commands/cmd/new">＋ New custom command</a>
</div>

<% if (cmds.length === 0) { %>
  <p class="empty">None yet — create one to add a <code>/command</code> to this server.</p>
<% } else { %>
  <% cmds.forEach(function (c) { %>
    <div class="cmd-override">
      <div class="cmd-override-head">
        <span>
          <strong>/<%= c.name %></strong>
          <span class="muted small">
            · <%= (c.actions || []).map(actionLabel).join(' → ') || 'no actions' %>
            <% if (c.cooldownSeconds) { %> · <%= c.cooldownSeconds %>s cooldown<% } %>
            <% if ((c.allowedRoles || []).length) { %> · role-limited<% } %>
            <% if ((c.allowedChannels || []).length) { %> · channel-limited<% } %>
          </span>
        </span>
      </div>
      <div class="btn-row">
        <a class="plugin-btn" href="/guilds/<%= guild.id %>/m/custom-commands/cmd/<%= c.id %>">Edit</a>
        <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/m/custom-commands/cmd/<%= c.id %>/delete">
          <button type="submit" class="danger" data-confirm="Delete /<%= c.name %>? It is removed from Discord too.">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>
