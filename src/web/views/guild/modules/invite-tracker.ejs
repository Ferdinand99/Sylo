<% var cfg = moduleConfig || {}; %>
<% var board = typeof inviteBoard !== 'undefined' && inviteBoard ? inviteBoard : { total: 0, rows: [], canReadInvites: true }; %>
<% var grace = cfg.graceHours == null ? 24 : cfg.graceHours; %>

<p class="muted small">
  Track how many people each member brings to the server and rank them on a leaderboard.
</p>

<% if (!board.canReadInvites) { %>
  <div class="banner bad">Sylo needs the <strong>Manage Server</strong> permission to read this server's
  invites — without it, joins can't be attributed to an inviter.</div>
<% } %>

<section class="card">
  <h3 style="margin:0 0 8px">How does it work?</h3>
  <ul class="muted small" style="margin:0; padding-left:18px; line-height:1.7">
    <li>Members get a personal invite link with <code>/invites</code> — that link is credited to them.</li>
    <li>When someone joins through a member's link, that member's invite count goes up.</li>
    <li><code>/inviter</code> shows who invited a given member; <code>/invites-leaderboard</code> ranks everyone.</li>
    <li>Anti-abuse: if an invited member leaves within <strong><%= grace %> hours</strong>, the inviter loses that credit.</li>
  </ul>
</section>

<form method="POST" action="/guilds/<%= guild.id %>/m/invite-tracker/config" hx-post="/guilds/<%= guild.id %>/m/invite-tracker/config" hx-target="#module-config" hx-swap="outerHTML" class="card stack" style="max-width:560px">
  <h3 style="margin:0">Settings</h3>

  <label class="small">Join / leave log channel <span class="muted">— optional</span></label>
  <select name="joinLogChannelId">
    <option value="">— none —</option>
    <% channels.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= c.id === (cfg.joinLogChannelId || '') ? 'selected' : '' %>>#<%= c.name %></option>
    <% }) %>
  </select>
  <p class="muted small">Sylo posts a line here each time someone joins or leaves, with who invited them.</p>

  <label class="small">Fake-invite grace window (hours)</label>
  <input type="number" name="graceHours" min="0" max="168" value="<%= grace %>" style="max-width:120px" />
  <p class="muted small">A join that leaves inside this window is not counted. <code>0</code> disables the guard.</p>

  <div><button type="submit">Save</button></div>
</form>

<section class="card">
  <h3 style="margin:0 0 8px">Leaderboard <span class="muted small"><%= board.total %> inviter<%= board.total === 1 ? '' : 's' %></span></h3>
  <% if (board.rows.length === 0) { %>
    <p class="muted small">No invites tracked yet.</p>
  <% } else { %>
    <table>
      <thead><tr><th>#</th><th>Member</th><th class="num">Invites</th><th class="num">joined</th><th class="num">left</th><th class="num">bonus</th></tr></thead>
      <tbody>
        <% board.rows.forEach(function (r) { %>
          <tr>
            <td><%= r.rank %></td>
            <td class="mono">&lt;@<%= r.userId %>&gt;</td>
            <td class="num"><strong><%= r.net %></strong></td>
            <td class="num"><%= r.regular %></td>
            <td class="num"><%= r.leaves %></td>
            <td class="num"><%= r.bonus %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<form method="POST" action="/guilds/<%= guild.id %>/m/invite-tracker/bonus" class="card stack" style="max-width:420px">
  <h3 style="margin:0">Adjust bonus invites</h3>
  <p class="muted small">Add or subtract from a member's total (e.g. to reward a giveaway). Sets the bonus outright.</p>
  <label class="small">Member ID or @mention</label>
  <input type="text" name="userId" placeholder="123456789012345678" required />
  <label class="small">Bonus value</label>
  <input type="number" name="bonus" value="0" required style="max-width:120px" />
  <div><button type="submit">Set bonus</button></div>
</form>
