<p class="muted">Disable a command in this server, or restrict it to channels / roles. Administrators always bypass these limits.</p>
<% commands.forEach(function (c) { %>
  <form method="POST" action="/guilds/<%= guild.id %>/commands/<%= c.name %>" class="cmd-override">
    <div class="cmd-override-head">
      <code>/<%= c.name %></code>
      <label class="switch">
        <input type="checkbox" name="enabled" <%= c.enabled ? 'checked' : '' %> />
        <span class="slider"></span>
      </label>
    </div>
    <p class="muted small"><%= c.description %></p>
    <label class="small">Limit to channels <span class="muted">— blank = all</span></label>
    <%- include('../partials/chip-picker', { field: 'channels', kind: 'channel', items: channels, selected: c.allowedChannels }) %>
    <label class="small" style="margin-top:8px">Limit to roles <span class="muted">— blank = everyone</span></label>
    <%- include('../partials/chip-picker', { field: 'roles', kind: 'role', items: roles, selected: c.allowedRoles }) %>
    <div style="margin-top:8px"><button type="submit">Save</button></div>
  </form>
<% }) %>
