<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Sylo' %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="topbar">
    <span class="brand">Sylo</span>
    <nav>
      <a href="/">Dashboard</a>
      <a href="/commands">Commands</a>
      <a href="/stats">Stats</a>
      <a href="/settings">Settings</a>
      <a href="/health">Health</a>
    </nav>

    <% var mg = typeof manageableGuilds !== 'undefined' ? manageableGuilds : []; %>
    <% if (mg.length) { %>
      <% var curG = mg.find(function (g) { return g.id === currentGuildId; }); %>
      <details class="srv-switch">
        <summary>
          <% if (curG && curG.icon) { %><img class="srv-switch-icon" src="<%= curG.icon %>" alt="" /><% } %>
          <span class="srv-switch-name"><%= curG ? curG.name : 'Select a server' %></span>
          <span class="srv-switch-caret" aria-hidden="true">▾</span>
        </summary>
        <div class="srv-switch-menu">
          <% mg.forEach(function (g) { %>
            <a href="/guilds/<%= g.id %>" class="<%= g.id === currentGuildId ? 'active' : '' %>">
              <% if (g.icon) { %><img src="<%= g.icon %>" alt="" /><% } else { %><span class="srv-switch-dot"></span><% } %>
              <span><%= g.name %></span>
            </a>
          <% }) %>
        </div>
      </details>
    <% } %>

    <span class="topbar-user">
      <% if (typeof user !== 'undefined' && user && !user.open) { %>
        <% if (user.avatar) { %><img class="avatar" src="<%= user.avatar %>" alt="" /><% } %>
        <span><%= user.name %></span>
        <a href="/auth/logout">Log out</a>
      <% } else if (typeof authEnabled !== 'undefined' && authEnabled) { %>
        <a href="/auth/discord/login">Log in with Discord</a>
      <% } else { %>
        <span class="tag-open">open mode — no auth</span>
      <% } %>
    </span>
  </header>
  <main>
