<% var cfg = moduleConfig || {}; var rules = Array.isArray(cfg.warnThresholds) ? cfg.warnThresholds : []; %>

<form method="POST" action="/guilds/<%= guild.id %>/m/moderation/config"
      hx-post="/guilds/<%= guild.id %>/m/moderation/config" hx-target="this" hx-swap="none"
      class="stack u-mw-lg">
  <label class="check">
    <input type="checkbox" name="dmOnPunish" <%= cfg.dmOnPunish !== false ? 'checked' : '' %> />
    DM the user when they are punished
  </label>

  <label class="u-mt-2">Warning thresholds</label>
  <p class="muted small">When a member reaches a warning count, apply an action automatically. The strictest matching rule wins.</p>

  <table class="thresholds">
    <thead><tr><th>At warning #</th><th>Action</th><th>Timeout (min)</th><th></th></tr></thead>
    <tbody id="threshold-rows">
      <% rules.forEach(function (r) { %>
        <tr>
          <td><input type="number" name="t_count" min="1" max="100" value="<%= r.count %>" /></td>
          <td>
            <select name="t_action">
              <% thresholdActions.forEach(function (a) { %>
                <option value="<%= a %>" <%= a === r.action ? 'selected' : '' %>><%= a %></option>
              <% }) %>
            </select>
          </td>
          <td><input type="number" name="t_duration" min="1" value="<%= r.durationMinutes || 60 %>" /></td>
          <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div><button type="button" class="secondary" id="add-threshold">+ Add rule</button></div>

  <label class="u-mt-3">Delete inactive cases after <span class="muted small">— days; 0 = keep forever</span></label>
  <input type="number" name="infractionRetentionDays" min="0" max="3650" value="<%= Number(cfg.infractionRetentionDays) || 0 %>" />
  <p class="muted small">
    A daily job removes cases that have been deleted (<code>/case delete</code>) or resolved (an unban / untimeout) once
    they are older than this. Active warnings and the visible history are never auto-removed.
  </p>

  <div class="u-mt-3"><button type="submit">Save</button></div>
</form>

<p class="muted small u-mt-4">
  The moderation log channel is set under <a href="/guilds/<%= guild.id %>/general">General</a>.
  Warnings and bans are managed under <a href="/guilds/<%= guild.id %>/moderation">Moderation</a>.
</p>

<template id="threshold-template">
  <tr>
    <td><input type="number" name="t_count" min="1" max="100" value="3" /></td>
    <td>
      <select name="t_action">
        <% thresholdActions.forEach(function (a) { %><option value="<%= a %>"><%= a %></option><% }) %>
      </select>
    </td>
    <td><input type="number" name="t_duration" min="1" value="60" /></td>
    <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
  </tr>
</template>
<script>
  document.getElementById('add-threshold')?.addEventListener('click', () => {
    const tpl = document.getElementById('threshold-template');
    document.getElementById('threshold-rows').appendChild(tpl.content.cloneNode(true));
  });
</script>
