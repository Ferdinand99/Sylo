{
  "name": "sylo",
  "version": "4.7.1",
  "description": "Multi-function Discord bot with a web dashboard and an extensible game-stats module (starting with the Battlefield series).",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node scripts/register-commands.js",
    "migrate-to-postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "test": "node --test",
    "build:v2": "vite build --config web-v2/vite.config.js",
    "dev:v2": "vite --config web-v2/vite.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "discord",
    "discord-bot",
    "battlefield",
    "stats",
    "dashboard"
  ],
  "author": "Ferdinand99",
  "license": "MIT",
  "dependencies": {
    "@fluxerjs/collection": "3.0.0",
    "@fluxerjs/core": "3.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "better-sqlite3": "^13.0.3",
    "cookie-session": "^2.1.1",
    "discord.js": "^14.16.3",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "undici": "^8.11.2",
    "vite": "^8.3.4"
  }
}
