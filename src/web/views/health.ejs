<%- include('partials/header', { title: 'Sylo — Health' }) %>

<h1 class="page-title">Health &amp; status</h1>
<p class="muted">Live bot state, module adoption across every server, and database backups.
  <code>GET /health</code> also returns this as JSON for uptime monitors.</p>

<section class="grid">
  <div class="card status <%= ready ? 'ok' : 'bad' %>">
    <h2>Bot</h2>
    <p class="big"><%= ready ? 'Online' : 'Offline' %></p>
    <p class="muted"><%= botTag ? botTag : 'not connected' %><% if (typeof syloVersion !== 'undefined' && syloVersion) { %> &middot; v<%= syloVersion %><% } %></p>
  </div>
  <div class="card">
    <h2>Servers</h2>
    <p class="big"><%= guildCount %></p>
    <p class="muted"><%= memberReach.toLocaleString('en') %> members reached</p>
  </div>
  <div class="card">
    <h2>Uptime</h2>
    <p class="big"><%= uptime %></p>
    <p class="muted">gateway ping <%= gatewayPing === null ? '—' : gatewayPing + ' ms' %></p>
  </div>
</section>

<% if (errors && errors.length) { %>
  <section class="card warn">
    <h2>Recent errors <span class="muted">(<%= errors.length %> shown, newest first)</span></h2>
    <table>
      <thead><tr><th>When</th><th>Scope</th><th>Message</th></tr></thead>
      <tbody>
        <% errors.forEach(function (e) { %>
          <tr>
            <td class="muted u-nowrap"><%= e.ago %></td>
            <td class="mono"><%= e.scope || '—' %></td>
            <td><%= e.message %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<section class="grid">
  <div class="card">
    <h2>Open tickets</h2>
    <p class="big"><%= stats.openTickets %></p>
    <p class="muted"><%= stats.ticketsTotal %> all-time</p>
  </div>
  <div class="card">
    <h2>Warnings</h2>
    <p class="big"><%= stats.warningsTotal %></p>
    <p class="muted"><%= stats.warningsWeek %> in the last 7 days</p>
  </div>
  <div class="card">
    <h2>Composed messages</h2>
    <p class="big"><%= stats.composedTotal %></p>
    <p class="muted">sent via Message Creator</p>
  </div>
  <div class="card">
    <h2>Cached stat lookups</h2>
    <p class="big"><%= stats.cachedLookups %></p>
    <p class="muted">Battlefield player queries</p>
  </div>
</section>

<section class="card">
  <h2>Module adoption</h2>
  <% if (modules.length === 0) { %>
    <p class="muted">No modules enabled yet — pick a server and turn some on.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Module</th><th class="num">Servers</th></tr></thead>
      <tbody>
        <% modules.forEach(function (m) { %>
          <tr>
            <td><%= m.icon %> <%= m.name %></td>
            <td class="num"><%= m.guilds %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="card">
  <h2>Database &amp; backups</h2>
  <% if (backupMsg) { %><div class="banner banner-flash ok">Backup created: <code><%= backupMsg %></code></div><% } %>
  <% if (backupErr) { %><div class="banner banner-flash bad">Backup failed: <%= backupErr %></div><% } %>
  <% if (importMsg) { %><div class="banner banner-flash ok">Imported <code><%= importMsg %></code> — use <strong>Restore</strong> on that row to load it.</div><% } %>
  <% if (importErr) { %><div class="banner banner-flash bad">Import rejected: <%= importErr %></div><% } %>
  <% if (restoreErr) { %><div class="banner banner-flash bad">Restore rejected: <%= restoreErr %></div><% } %>
  <p class="muted">
    Database <strong><%= db.size %></strong> (WAL <%= db.wal %>).
    <% if (db.intervalHours > 0) { %>
      Automatic snapshot every <%= db.intervalHours %>h, keeping the newest <%= db.retention %>.
    <% } else { %>
      Scheduled backups are off — a snapshot is still taken before every schema migration.
    <% } %>
    Snapshots are written to <code>&lt;data&gt;/backups</code> on the mounted volume.
  </p>
  <div class="btn-row u-m0 u-mt-3">
    <form method="POST" action="/health/backups" hx-boost="false">
      <button type="submit">Create backup now</button>
    </form>
    <span id="db-import">
      <input type="file" id="db-import-file" accept=".db,.sqlite,.sqlite3,application/octet-stream" />
      <button type="button" id="db-import-btn" class="secondary" disabled>Import .db file…</button>
    </span>
  </div>
  <p class="muted small">Importing stores the file as a snapshot; you then <strong>Restore</strong> it.
    Restoring replaces the live database and restarts the bot (a <code>prerestore</code> snapshot is taken first).</p>
  <% if (backups.length === 0) { %>
    <p class="muted">No snapshots yet.</p>
  <% } else { %>
    <table>
      <thead><tr><th>File</th><th class="num">Size</th><th>Age</th><th></th></tr></thead>
      <tbody>
        <% backups.forEach(function (b) { %>
          <tr>
            <td><a href="/health/backups/<%= encodeURIComponent(b.name) %>"><%= b.name %></a></td>
            <td class="num"><%= b.size %></td>
            <td class="muted"><%= b.ago %></td>
            <td class="num">
              <div class="btn-row" style="justify-content:flex-end;margin:0">
                <form method="POST" action="/health/backups/<%= encodeURIComponent(b.name) %>/restore" hx-boost="false"
                      data-confirm="Restore the database from &quot;<%= b.name %>&quot;? This replaces all current data and restarts the bot.">
                  <button type="submit">Restore</button>
                </form>
                <form method="POST" action="/health/backups/<%= encodeURIComponent(b.name) %>/delete" hx-boost="false" data-confirm="Delete this backup permanently?">
                  <button type="submit" class="danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<script>
  (function () {
    var input = document.getElementById('db-import-file');
    var btn = document.getElementById('db-import-btn');
    if (!input || !btn) return;
    input.addEventListener('change', function () { btn.disabled = !input.files.length; });
    btn.addEventListener('click', function () {
      var file = input.files[0];
      if (!file) return;
      if (!window.confirm('Upload "' + file.name + '" as a backup snapshot?')) return;
      btn.disabled = true;
      btn.textContent = 'Uploading…';
      fetch('/health/backups/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/octet-stream' },
        body: file,
      })
        .then(function (r) { location.href = r.url || '/health'; })
        .catch(function () { location.href = '/health?importerr=upload%20failed'; });
    });
  })();
</script>

<%- include('partials/footer') %>
