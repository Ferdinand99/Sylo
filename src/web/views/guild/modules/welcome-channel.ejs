<% var cfg = moduleConfig || {}; %>
<% var spec = (cfg.spec && typeof cfg.spec === 'object') ? cfg.spec : { content: '', embeds: [] }; %>

<div x-data="embedList(<%= JSON.stringify({ max: 10, presets: wcPresets, spec: spec }) %>)">
  <div class="wc-top">
    <p class="muted small" style="margin:0">
      Build one rich message for a dedicated <strong>read-only</strong> channel. Click any text to edit it in
      place; click a picture area to set an image URL. Placeholders: <code>{server}</code>, <code>{memberCount}</code>.
    </p>
    <button type="button" id="wc-reset" class="link-btn" @click="reset()">↺ Reset to default</button>
  </div>

  <div class="wc-channel-row">
    <form method="POST" action="/guilds/<%= guild.id %>/m/welcome-channel/config" id="wc-form" class="stack" style="flex:1">
      <label class="small">Channel</label>
      <select name="channelId">
        <option value="">— select a channel —</option>
        <% channels.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= c.id === (cfg.channelId || '') ? 'selected' : '' %>>#<%= c.name %></option>
        <% }) %>
      </select>
      <input type="hidden" name="spec" id="wc-spec" />
    </form>
    <form method="POST" action="/guilds/<%= guild.id %>/m/welcome-channel/create-channel">
      <button type="submit" class="secondary">Create read-only #welcome</button>
    </form>
  </div>

  <label class="small" style="margin-top:6px">Message text <span class="muted">— optional, shown above the embeds</span></label>
  <textarea x-model="content" rows="2" placeholder="Welcome to {server}!"></textarea>

  <div class="wc-stage">
    <template x-if="!items.length">
      <p class="muted wc-empty">No elements yet — pick one from “Add element” below.</p>
    </template>
    <template x-for="(row, i) in items" :key="row.id">
      <div class="wc-embed" :class="{ 'wc-isbanner': row.kind === 'banner' }" :style="'--wc-color:' + row.color">
        <div class="wc-tools">
          <button type="button" @click="move(i, -1)" title="Move up">▲</button>
          <button type="button" @click="move(i, 1)" title="Move down">▼</button>
          <button type="button" @click="remove(i)" title="Delete">✕</button>
        </div>

        <template x-if="row.kind === 'banner'">
          <button type="button" class="wc-image wc-image-lg" :class="{ has: row.image }" @click="pickImg(row, 'image')">
            <template x-if="row.image"><img :src="row.image" alt="" /></template>
            <template x-if="!row.image"><span>＋ Add a banner image</span></template>
          </button>
        </template>
        <template x-if="row.kind === 'banner'">
          <div class="wc-ed" contenteditable="plaintext-only" data-ph="Caption (optional)"
               x-init="$el.textContent = row.description" @input="row.description = $el.textContent"></div>
        </template>

        <template x-if="row.kind !== 'banner'">
          <label class="wc-colorwrap" title="Embed colour"><input type="color" class="wc-color" x-model="row.color" /></label>
        </template>
        <template x-if="row.kind !== 'banner'">
          <button type="button" class="wc-thumb" :class="{ has: row.thumbnail }" @click="pickImg(row, 'thumbnail')">
            <template x-if="row.thumbnail"><img :src="row.thumbnail" alt="" /></template>
            <template x-if="!row.thumbnail"><span>thumb</span></template>
          </button>
        </template>
        <template x-if="row.kind !== 'banner'">
          <div class="wc-embed-body">
            <div class="wc-row">
              <button type="button" class="wc-icon" :class="{ has: row.authorIcon }"
                      :style="{ backgroundImage: row.authorIcon ? ('url(' + JSON.stringify(row.authorIcon) + ')') : '' }"
                      @click="pickImg(row, 'authorIcon')"></button>
              <div class="wc-ed" contenteditable="plaintext-only" data-ph="Header"
                   x-init="$el.textContent = row.authorName" @input="row.authorName = $el.textContent"></div>
            </div>
            <div class="wc-ed wc-title" contenteditable="plaintext-only" data-ph="Title"
                 x-init="$el.textContent = row.title" @input="row.title = $el.textContent"></div>
            <div class="wc-ed wc-desc" contenteditable="plaintext-only" data-ph="Description"
                 x-init="$el.textContent = row.description" @input="row.description = $el.textContent"></div>
            <div class="wc-fields">
              <template x-for="(f, fi) in row.fields" :key="f.id">
                <div class="wc-field">
                  <div class="wc-ed wc-fname" contenteditable="plaintext-only" data-ph="Field name"
                       x-init="$el.textContent = f.name" @input="f.name = $el.textContent"></div>
                  <div class="wc-ed wc-fval" contenteditable="plaintext-only" data-ph="Field value"
                       x-init="$el.textContent = f.value" @input="f.value = $el.textContent"></div>
                  <button type="button" class="wc-x" @click="removeField(row, fi)" title="Remove field">&times;</button>
                </div>
              </template>
            </div>
            <button type="button" class="wc-addfield" @click="addField(row)">+ Add new field</button>
            <button type="button" class="wc-image" :class="{ has: row.image }" @click="pickImg(row, 'image')">
              <template x-if="row.image"><img :src="row.image" alt="" /></template>
              <template x-if="!row.image"><span>＋ Add an image</span></template>
            </button>
            <div class="wc-row wc-footrow">
              <button type="button" class="wc-icon" :class="{ has: row.footerIcon }"
                      :style="{ backgroundImage: row.footerIcon ? ('url(' + JSON.stringify(row.footerIcon) + ')') : '' }"
                      @click="pickImg(row, 'footerIcon')"></button>
              <div class="wc-ed" contenteditable="plaintext-only" data-ph="Footer"
                   x-init="$el.textContent = row.footerText" @input="row.footerText = $el.textContent"></div>
            </div>
          </div>
        </template>
      </div>
    </template>
  </div>

  <div class="wc-add-bar">
    <div class="wc-add-head">Add element</div>
    <div class="wc-add-grid" id="wc-add-grid">
      <template x-for="p in presets" :key="p.id">
        <button type="button" class="wc-add-card" @click="addPreset(p.id)" :disabled="full">
          <b x-text="p.label"></b><span class="wc-add-mini" :class="'wc-add-' + p.kind"></span>
        </button>
      </template>
    </div>
  </div>

  <div class="wc-actions">
    <button type="submit" form="wc-form" name="action" value="save">Save draft</button>
    <button type="submit" form="wc-form" name="action" value="publish" class="btn-primary">Publish to channel</button>
    <% if (cfg.messageId) { %>
      <form method="POST" action="/guilds/<%= guild.id %>/m/welcome-channel/unpublish" style="display:inline">
        <button type="submit" class="danger">Remove published message</button>
      </form>
    <% } %>
  </div>
</div>
