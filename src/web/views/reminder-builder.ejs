<%- include('partials/header', { title: `Sylo — ${isNew ? 'New' : 'Edit'} reminder` }) %>

<% var e0 = (rec.spec && rec.spec.embeds && rec.spec.embeds[0]) || null; %>
<% var msgType = e0 ? 'embed' : 'text'; %>
<% var schedMode = rec.mode === 'single' ? 'single' : 'multiple'; %>
<% function localDT(ms) { if (!ms) return ''; var d = new Date(ms - new Date(ms).getTimezoneOffset() * 60000); return d.toISOString().slice(0, 16); } %>

<p class="muted"><a href="/guilds/<%= guildId %>/m/reminders">&larr; Reminders</a></p>

<div class="rr-builder-head">
  <input type="text" form="rem-form" name="name" class="mb-name" maxlength="100"
         value="<%= rec.name || '' %>" placeholder="my new reminder" />
  <div class="rr-actions">
    <a class="btn" href="/guilds/<%= guildId %>/m/reminders">Discard</a>
    <button type="submit" form="rem-form" name="action" value="save" class="btn btn-primary">Save &amp; close</button>
  </div>
</div>

<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="banner <%= (['saved','rem-test'].indexOf(msg) >= 0) ? 'ok' : 'bad' %>">
    <%= ({ saved:'Saved.', 'rem-test':'Test message sent to the channel.', badchannel:'Pick a channel.', 'rem-empty':'Add a message (text or embed).', 'rem-when':'Pick a date and time for the single reminder.' })[msg] || (function(){ try { return decodeURIComponent(msg); } catch(e){ return msg; } })() %>
  </div>
<% } %>

<form method="POST" action="/guilds/<%= guildId %>/m/reminders/r/<%= isNew ? 'new' : rec.id %>" id="rem-form" class="stack u-mw-xl"
      x-data="reminderBuilder(<%= JSON.stringify({ msgType: msgType, mode: schedMode, enableStart: !!rec.start_at, enableEnd: !!rec.end_at }) %>)">
  <input type="hidden" name="embed" />

  <section class="card stack">
    <h2 class="u-m0">Channel</h2>
    <select class="u-mw-md" name="channelId" required>
      <option value="">— select a channel —</option>
      <% channels.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= c.id === rec.channel_id ? 'selected' : '' %>>#<%= c.name %></option>
      <% }) %>
    </select>
  </section>

  <section class="card">
    <h2 class="u-m0 u-mb-2">Message</h2>
    <div class="rem-tabs">
      <button type="button" @click="msgType = 'text'" :class="{ active: msgType === 'text' }">Text message</button>
      <button type="button" @click="msgType = 'embed'" :class="{ active: msgType === 'embed' }">Embed message</button>
    </div>
    <input type="hidden" name="msgType" :value="msgType" />

    <% var curContent = rec.spec && rec.spec.content ? rec.spec.content : ''; %>
    <div class="u-stack u-mt-2" x-show="msgType === 'text'">
      <textarea name="content" rows="3" maxlength="2000" placeholder="Hey, I'm a reminder!"
                :disabled="msgType !== 'text'" <%= msgType === 'embed' ? 'disabled' : '' %>><%= msgType === 'text' ? curContent : '' %></textarea>
    </div>
    <div class="u-stack u-mt-2" x-show="msgType === 'embed'">
      <label class="small">Text above the embed <span class="muted">— optional</span></label>
      <textarea name="content" rows="2" placeholder="Optional message above the embed…"
                :disabled="msgType !== 'embed'" <%= msgType === 'text' ? 'disabled' : '' %>><%= msgType === 'embed' ? curContent : '' %></textarea>
      <%- include('partials/embed-editor', { hidden: 'embed', spec: e0 || {} }) %>
    </div>

    <div class="u-mt-3">
      <button type="submit" name="action" value="test" class="secondary">Send test message</button>
    </div>
  </section>

  <section class="card stack">
    <h2 class="u-m0">Reminder</h2>
    <div class="rem-tabs">
      <button type="button" @click="mode = 'single'" :class="{ active: mode === 'single' }">Single</button>
      <button type="button" @click="mode = 'multiple'" :class="{ active: mode === 'multiple' }">Multiple</button>
    </div>
    <input type="hidden" name="mode" :value="mode" />

    <div class="stack" x-show="mode === 'single'">
      <label class="small">Send once at</label>
      <input type="datetime-local" name="runAt" value="<%= localDT(rec.run_at) %>" />
    </div>

    <div class="stack" x-show="mode === 'multiple'">
      <label class="small">Every</label>
      <select class="u-mw-xs" name="intervalMinutes">
        <% schedulePresets.forEach(function (p) { %>
          <option value="<%= p[0] %>" <%= Number(p[0]) === rec.interval_minutes ? 'selected' : '' %>><%= p[1] %></option>
        <% }) %>
      </select>

      <label class="checkline"><input type="checkbox" name="enableStart" x-model="enableStart" /> Add start time</label>
      <input class="u-mw-xs" type="datetime-local" name="startAt" :disabled="!enableStart"
             value="<%= localDT(rec.start_at) %>" />

      <label class="checkline"><input type="checkbox" name="enableEnd" x-model="enableEnd" /> Add end time</label>
      <input class="u-mw-xs" type="datetime-local" name="endAt" :disabled="!enableEnd"
             value="<%= localDT(rec.end_at) %>" />

      <label class="small u-mt-2">Day of the week</label>
      <div class="rem-days">
        <% weekdays.forEach(function (d) { var on = (rec.dayList || []).indexOf(d[0]) !== -1; %>
          <label class="rem-day <%= on ? 'on' : '' %>" x-data="{ on: <%= on ? 'true' : 'false' %> }" :class="{ on }">
            <input type="checkbox" name="day_<%= d[0] %>" <%= on ? 'checked' : '' %> @change="on = $event.target.checked" /> <%= d[1] %>
          </label>
        <% }) %>
      </div>
    </div>
  </section>
</form>

<%- include('partials/footer') %>
