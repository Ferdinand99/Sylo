<% var sb = typeof sidebar !== 'undefined' ? sidebar : { top: [], guild: null, categories: [] }; %>
<% var mg = typeof manageableGuilds !== 'undefined' ? manageableGuilds : []; %>
<% function ico(n) { return n ? '<svg class="sb-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-' + n + '"/></svg>' : ''; } %>
<% function navrow(i) { %>
  <a class="sb-link <%= i.active ? 'active' : '' %>" href="<%= i.href %>"<% if (i.id) { %> data-module="<%= i.id %>"<% } %>>
    <% if (typeof i.dot !== 'undefined') { %><span class="sb-dot <%= i.dot %>"></span><% } %>
    <%- ico(i.icon) %>
    <span><%= i.label %></span>
  </a>
<% } %>

<div class="layout">
  <button type="button" class="sb-scrim" aria-label="Close menu"></button>
  <aside class="sidebar">
    <a class="sb-brand" href="/">
      <span class="sb-mark">S</span><span>Sylo</span>
    </a>

    <% var curG = sb.guild || (mg.length ? mg.find(function (g) { return g.id === (typeof activeGuildId !== 'undefined' ? activeGuildId : null); }) : null); %>
    <% var loggedIn = typeof user !== 'undefined' && user && !user.open; %>
    <% var inviteUrl = typeof botInviteUrl !== 'undefined' ? botInviteUrl : ''; %>
    <% if (mg.length || loggedIn) { %>
      <details class="srv-switch">
        <summary>
          <span class="srv-switch-face">
            <% if (curG && curG.icon) { %><img class="srv-switch-icon" src="<%= curG.icon %>" alt="" /><% } else { %><span class="srv-switch-ph"><%= curG ? curG.name.charAt(0) : '+' %></span><% } %>
            <span class="srv-switch-name"><%= curG ? curG.name : 'Select a server' %></span>
          </span>
          <span class="srv-switch-caret" aria-hidden="true">▾</span>
        </summary>
        <div class="srv-switch-menu">
          <% mg.forEach(function (g) { %>
            <a href="/guilds/<%= g.id %>/overview" class="<%= curG && g.id === curG.id ? 'active' : '' %>">
              <% if (g.icon) { %><img src="<%= g.icon %>" alt="" /><% } else { %><span class="srv-switch-dot"><%= g.name.charAt(0) %></span><% } %>
              <span><%= g.name %></span>
            </a>
          <% }) %>
          <% if (inviteUrl) { %>
            <a class="srv-switch-add" href="<%= inviteUrl %>" target="_blank" rel="noopener">
              <span class="srv-switch-dot" aria-hidden="true">＋</span>
              <span>Add new server</span>
            </a>
          <% } %>
        </div>
      </details>
    <% } %>

    <nav class="sb-nav">
      <% sb.top.forEach(function (i) { navrow(i); }); %>

      <% sb.categories.forEach(function (cat) { %>
        <details class="sb-modgroup" data-k="<%= cat.key %>" open>
          <summary class="sb-cat"><span><%= cat.title %></span><span class="sb-chev">▾</span></summary>
          <% cat.items.forEach(function (it) { navrow(it); }); %>
        </details>
      <% }) %>
    </nav>

    <div class="sb-foot">
      <% if (typeof user !== 'undefined' && user && !user.open) { %>
        <div class="sb-user">
          <% if (user.avatar) { %><img class="avatar" src="<%= user.avatar %>" alt="" /><% } %>
          <span class="sb-user-name"><%= user.name %></span>
          <a href="/auth/logout" title="Log out">Log out</a>
        </div>
      <% } else if (typeof authEnabled !== 'undefined' && authEnabled) { %>
        <a class="sb-login" href="/auth/discord/login">Log in with Discord</a>
      <% } else { %>
        <span class="tag-open">open mode — no auth</span>
      <% } %>
    </div>
  </aside>

  <div class="content">
    <header class="mobilebar">
      <button type="button" class="sb-toggle" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
      <span class="brand">Sylo</span>
    </header>
    <main>
