<%- include('partials/header', { title: 'Sylo — Account' }) %>

<h1 class="page-title">Account</h1>
<p class="muted">The platforms you sign in with. Connect a second one to manage your servers on both with the same account.</p>

<% if (flash) { %><div class="banner banner-flash <%= flash.kind %>"><%= flash.text %></div><% } %>

<% platforms.forEach(function (p) { %>
  <section class="card">
    <h2><%= p.label %></h2>
    <% if (p.connected) { %>
      <p>Connected as <strong><%= p.username %></strong>
        <span class="muted">· manages <%= p.guildCount %> server<%= p.guildCount === 1 ? '' : 's' %> with Sylo</span></p>
      <% if (p.canDisconnect) { %>
        <form method="post" action="/account/disconnect/<%= p.platform %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn">Disconnect <%= p.label %></button>
        </form>
      <% } else { %>
        <p class="muted">This is your only sign-in, so it can't be disconnected.</p>
      <% } %>
    <% } else if (p.connectHref) { %>
      <p class="muted">Not connected.</p>
      <p><a class="btn" href="<%= p.connectHref %>" hx-boost="false">Connect <%= p.label %></a></p>
    <% } %>
  </section>
<% }); %>

<section class="card">
  <h2>Signed-in devices</h2>
  <p class="muted">Devices signed in to the Sylo app with this account. Revoke one you no longer use or don't recognise; it is signed out at once.</p>
  <% if (!devices.length) { %>
    <p class="muted">No devices are signed in.</p>
  <% } %>
  <% devices.forEach(function (d) { %>
    <div style="display: flex; gap: 0.75rem; justify-content: space-between; align-items: center; margin-top: 0.6rem;">
      <span><strong><%= d.deviceName %></strong> <span class="muted">· last used <%= d.lastUsed %></span></span>
      <form method="post" action="/account/devices/<%= d.id %>/revoke" class="u-m0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn">Revoke</button>
      </form>
    </div>
  <% }); %>
</section>

<section class="card">
  <h2>Delete account</h2>
  <p class="muted">Deletes your Sylo dashboard account: your sign-ins, every browser and Sylo app device
    signed in with it, and your dashboard preferences. Data Sylo keeps per server (levels, birthdays,
    tickets …) stays with each server; run <code>/forget</code> there to remove it.</p>
  <form method="post" action="/account/delete" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="checkline"><input type="checkbox" name="confirm" /> I understand this can't be undone.</label>
    <div><button type="submit" class="danger" data-confirm="Delete your Sylo account? This can't be undone.">Delete account</button></div>
  </form>
</section>

<%- include('partials/footer') %>
