# ---- Platforms ----
# Sylo can run on Discord, on Fluxer, or on both from one process: set the
# credentials of each platform you use and leave the other's blank. At least one
# is required. (Fluxer support is experimental.)

# ---- Discord ----
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Application (client) ID from the same page -> General Information
DISCORD_CLIENT_ID=
# Optional: register slash commands instantly to one guild, or several
# (comma/space-separated), for development. Leave blank in production to register
# globally. (Pre-3.0 name DISCORD_GUILD_ID still works, with a warning.)
# DISCORD_DEV_GUILD_IDS=111111111111111111,222222222222222222
# Gateway shards this process runs. "auto" (default) follows Discord's
# recommendation — it stays at 1 until the bot is in ~2,500+ servers, so it is a
# no-op for small instances. Pin an integer to override. One process either way.
# DISCORD_SHARD_COUNT=auto

# ---- Fluxer (experimental) ----
# Bot token and application ID from your Fluxer application's bot page. Leave
# both blank to run on Discord only.
# FLUXER_TOKEN=
# FLUXER_CLIENT_ID=
# Which Fluxer instance to talk to. Unset = hosted Fluxer. For a self-hosted
# instance set its web app origin; the API, gateway and CDN hosts are read from
# <origin>/.well-known/fluxer. FLUXER_API_URL overrides the API origin only.
# FLUXER_WEB_URL=https://chat.example.com
# FLUXER_API_URL=
# Fluxer has no slash commands yet, so commands run from chat: <prefix>ping, or
# @Sylo ping. 1-5 characters, no spaces.
# COMMAND_PREFIX=!
# "Log in with Fluxer" for the dashboard: the application's client secret. In the
# application on your Fluxer instance, add <DASHBOARD_URL>/auth/fluxer/callback as a
# redirect URL (locally: http://localhost:3000/auth/fluxer/callback). With this set
# alongside DISCORD_CLIENT_SECRET, one dashboard account can hold both identities.
# FLUXER_CLIENT_SECRET=
# Your Fluxer user id(s), comma/space-separated: the Fluxer counterpart of OWNER_IDS
# (which holds Discord ids). Operators reach /health and the other bot-wide pages.
# FLUXER_OWNER_IDS=

# ---- Web dashboard ----
WEB_PORT=3000
# Dashboard auth: set DISCORD_CLIENT_SECRET (same app -> OAuth2) to require
# "Log in with Discord", gated to server admins. Leave blank to run the
# dashboard open (localhost / trusted LAN only).
# DISCORD_CLIENT_SECRET=
# Signing key for the session cookie. Auto-generated if blank, but then sessions
# drop on every restart — pin it in production (any long random string).
# SESSION_SECRET=
# Public URL of the dashboard, only needed behind a reverse proxy so the OAuth2
# redirect URI is correct. Otherwise derived from the request.
# DASHBOARD_URL=https://sylo.example.com
# Your Discord user id(s), comma/space-separated. With DISCORD_CLIENT_SECRET set,
# only these accounts can reach /health (status, error log, database
# backup/restore) — every other signed-in user is blocked, not just non-admins.
# OWNER_IDS=
# Channel id Sylo posts its own errors to (a "dev-log" — distinct from any
# per-guild logging/modlog channel). Optional; without it there's no proactive
# notification, same as today. Sylo just needs to be in that server and able
# to send embeds there.
# DEV_LOG_CHANNEL_ID=

# ---- Verification captcha (optional) ----
# Cloudflare Turnstile keys enable the Verification module's captcha mode. Free
# at https://dash.cloudflare.com -> Turnstile. Without both, captcha mode falls
# back to a plain Verify button. Needs DASHBOARD_URL set (members open a link).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---- Free games: extra stores (optional) ----
# IsThereAnyDeal API key broadens the Free games module beyond the Epic Games
# Store (Steam, GOG, Fanatical, Humble, …). Free key: isthereanydeal.com/apps.
# Without it, Free games is Epic-only.
# ITAD_API_KEY=

# ---- Twitch alerts (optional) ----
# App client id + secret for the Twitch alerts module ("go live" notifications).
# Register a free app at https://dev.twitch.tv/console (OAuth redirect can be any
# https URL; the module uses the client-credentials flow). Without both, the
# module's poll loop no-ops.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# ---- Kick alerts (optional) ----
# App client id + secret for the Kick alerts module ("go live" notifications).
# Create a free app under https://kick.com/settings/developer (the module uses
# the client-credentials flow). Without both, the module's poll loop no-ops.
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=

# ---- App Store Connect alerts (optional, owner-only module) ----
# An App Store Connect API key for the "App Store Connect" module: app version state, builds,
# reviews, TestFlight feedback, certificate expiry and daily downloads. Create it under
# https://appstoreconnect.apple.com -> Users and Access -> Integrations. Only the Sylo owner
# (OWNER_IDS / FLUXER_OWNER_IDS) can see or enable the module. Without a key it does nothing.
# APPLE_KEY_ID=
# APPLE_ISSUER_ID=           (team keys; leave blank for an individual key)
# The .p8 file: the PEM text, the PEM on one line with literal \n, or base64 of the file.
# APPLE_PRIVATE_KEY=
# For the daily downloads digest: Sales and Trends -> Reports -> your vendor number.
# APPLE_VENDOR_NUMBER=

# ---- Push notifications for the Sylo app (optional) ----
# New tickets reach the app through the hosted Sylo's relay; leave unset to use it.
# PUSH_RELAY_URL=https://app.sylobot.com
# Set it empty (PUSH_RELAY_URL=) to turn push notifications off for this instance.
# Hosted Sylo only: the app's APNs auth key (Apple Developer -> Keys). With these set the
# instance talks to Apple itself and serves the relay for self-hosted instances.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# The .p8 file: the PEM text, the PEM on one line with literal \n, or base64 of the file.
# APNS_PRIVATE_KEY=
# The app's bundle id.
# APNS_TOPIC=net.opland.sylo

# ---- Privileged intents ----
# Needed for modules that watch members/messages (logging, welcome, autoroles,
# leveling, automod). Enable the matching toggles on the Discord Developer
# Portal (Bot page); verified bots may also need Discord's approval. Set a flag
# to false to boot without that intent (dependent modules stay disabled).
# INTENT_GUILD_MEMBERS=true
# INTENT_MESSAGE_CONTENT=true

# ---- Game stats (module, off by default) ----
# Powers the "Game stats" module: /stats battlefield <title> <user> <platform>.
# Enable the module per server on the dashboard. These only tune the upstream
# API and how long a lookup is cached.
GAMETOOLS_API_BASE=https://api.gametools.network
STATS_CACHE_TTL_MINUTES=5

# ---- Persistence ----
# SQLite database file. In Docker this should live under the mounted volume.
DATABASE_PATH=./data/sylo.db
# Optional: use Postgres instead of SQLite (hosted-scale deployments only —
# see docs/postgres.md). Leave unset; almost nobody self-hosting needs this.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Automatic database backups (compacted .db snapshots). One is always taken just
# before a schema migration; these control the scheduled + retained copies.
# BACKUP_DIR=            # defaults to <db dir>/backups
# BACKUP_INTERVAL_HOURS=24   # 0 disables the scheduled backup
# BACKUP_RETENTION=7        # how many snapshots to keep
# Off-site copies (optional): after every snapshot a gzipped copy is pushed to
# whichever of these is set — best-effort, logged, never blocks the local backup.
# WebDAV target, e.g. a Nextcloud folder — the file is PUT to <url>/<name>.db.gz:
# BACKUP_WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/me/sylo-backups
# BACKUP_WEBDAV_USER=
# BACKUP_WEBDAV_PASS=       # use an app password, not your account password
# Discord webhook — uploaded as an attachment (skipped over the ~8 MiB limit):
# BACKUP_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---- Logging ----
# LOG_LEVEL=info        # debug | info | warn | error
#                       # debug also turns on one line per HTTP request
# LOG_FORMAT=text       # text | json  (LOG_JSON=1 is shorthand for json)
# Prometheus metrics are always exposed, unauthenticated, at GET /metrics
# (same trust level as GET /health) — scrape it from your LAN or your own proxy.

# ---- Misc ----
# NODE_ENV=production
# Timezone for transcript timestamps (IANA name). Docker defaults to Europe/Oslo.
# TZ=Europe/Oslo
