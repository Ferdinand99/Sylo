<%# The swappable module-settings fragment. Rendered inside guild.ejs on a full
    page load, and on its own as the htmx target for GET nav / config POST.
    Reads everything from inherited locals (see moduleViewLocals in guilds.js). %>
<div id="module-config">
  <% if (typeof platformNote !== 'undefined' && platformNote) { %>
    <p class="platform-note"><span class="platform-note-tag"><%= platform === 'fluxer' ? 'Fluxer' : 'Discord' %></span> <%= platformNote %></p>
  <% } %>
  <%- include(configPartialRel) %>
</div>
