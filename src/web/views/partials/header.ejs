<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Sylo' %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="topbar">
    <span class="brand">Sylo</span>
    <nav>
      <a href="/">Dashboard</a>
      <a href="/commands">Commands</a>
      <a href="/stats">Stats</a>
      <a href="/health">Health</a>
    </nav>
    <span class="topbar-user">
      <% if (typeof user !== 'undefined' && user && !user.open) { %>
        <% if (user.avatar) { %><img class="avatar" src="<%= user.avatar %>" alt="" /><% } %>
        <span><%= user.name %></span>
        <a href="/auth/logout">Log out</a>
      <% } else if (typeof authEnabled !== 'undefined' && authEnabled) { %>
        <a href="/auth/login">Log in with Discord</a>
      <% } else { %>
        <span class="tag-open">open mode — no auth</span>
      <% } %>
    </span>
  </header>
