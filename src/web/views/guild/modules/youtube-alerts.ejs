<% var cfg = moduleConfig || {}; var alerts = Array.isArray(cfg.alerts) ? cfg.alerts : []; %>
<% var vMsg = typeof ytVideoMessage !== 'undefined' ? ytVideoMessage : ''; %>
<% var lMsg = typeof ytLiveMessage !== 'undefined' ? ytLiveMessage : ''; %>
<% function notifyVal(a) { if (a.onVideo && a.onLive) return 'both'; if (a.onLive) return 'live'; return 'video'; } %>

<p class="muted small">
  Add a channel by URL or <code>@handle</code> — Sylo resolves it on save. New uploads come from
  YouTube's public feed; "went live" is detected from the channel's live page (no API key needed).
  Checks run about every 3 minutes. Message placeholders: <code>{name}</code> <code>{title}</code> <code>{url}</code>.
</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/youtube-alerts/config" hx-post="/guilds/<%= guild.id %>/m/youtube-alerts/config" hx-target="#module-config" hx-swap="outerHTML" class="stack" style="max-width:680px">
  <div id="yt-rows">
    <% (alerts.length ? alerts : [{ ytChannelId: '', name: '', discordChannelId: '', roleId: '', onVideo: true, onLive: false, videoMessage: '', liveMessage: '' }]).forEach(function (a) { %>
      <div class="tw-row card stack">
        <input type="hidden" name="yt_resolvedId" value="<%= a.ytChannelId || '' %>" />
        <input type="hidden" name="yt_resolvedName" value="<%= a.name || '' %>" />
        <div class="star-age">
          <div class="stack" style="flex:1">
            <label class="small">YouTube channel <span class="muted">— URL or @handle</span></label>
            <input type="text" name="yt_input" value="<%= a.ytChannelId ? ('@' + (a.name || a.ytChannelId)) : '' %>" placeholder="@MrBeast or a channel URL" />
            <% if (a.ytChannelId) { %><span class="muted small mono">resolved: <%= a.ytChannelId %></span><% } %>
          </div>
          <div class="stack" style="flex:1">
            <label class="small">Announce in</label>
            <select name="yt_channel">
              <option value="">— select a channel —</option>
              <% channels.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= c.id === a.discordChannelId ? 'selected' : '' %>>#<%= c.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="star-age">
          <div class="stack" style="flex:1">
            <label class="small">Notify on</label>
            <select name="yt_notify">
              <option value="both" <%= notifyVal(a) === 'both' ? 'selected' : '' %>>New videos &amp; going live</option>
              <option value="video" <%= notifyVal(a) === 'video' ? 'selected' : '' %>>New videos only</option>
              <option value="live" <%= notifyVal(a) === 'live' ? 'selected' : '' %>>Going live only</option>
            </select>
          </div>
          <div class="stack" style="flex:1">
            <label class="small">Ping role <span class="muted">— optional</span></label>
            <select name="yt_role">
              <option value="">— none —</option>
              <% roles.forEach(function (r) { %>
                <option value="<%= r.id %>" <%= r.id === a.roleId ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <label class="small">New-video message</label>
        <textarea name="yt_videoMessage" rows="2" maxlength="1500" placeholder="<%= vMsg %>"><%= a.videoMessage || '' %></textarea>
        <label class="small">Went-live message</label>
        <textarea name="yt_liveMessage" rows="2" maxlength="1500" placeholder="<%= lMsg %>"><%= a.liveMessage || '' %></textarea>
        <div><button type="button" class="link-btn" onclick="this.closest('.tw-row').remove()">remove</button></div>
      </div>
    <% }) %>
  </div>
  <div><button type="button" class="secondary" id="yt-add">＋ Add channel</button></div>
  <div style="margin-top:10px"><button type="submit">Save</button></div>
</form>

<template id="yt-template">
  <div class="tw-row card stack">
    <input type="hidden" name="yt_resolvedId" value="" />
    <input type="hidden" name="yt_resolvedName" value="" />
    <div class="star-age">
      <div class="stack" style="flex:1"><label class="small">YouTube channel <span class="muted">— URL or @handle</span></label>
        <input type="text" name="yt_input" placeholder="@MrBeast or a channel URL" /></div>
      <div class="stack" style="flex:1"><label class="small">Announce in</label>
        <select name="yt_channel"><option value="">— select a channel —</option>
          <% channels.forEach(function (c) { %><option value="<%= c.id %>">#<%= c.name %></option><% }) %></select></div>
    </div>
    <div class="star-age">
      <div class="stack" style="flex:1"><label class="small">Notify on</label>
        <select name="yt_notify"><option value="both">New videos &amp; going live</option><option value="video">New videos only</option><option value="live">Going live only</option></select></div>
      <div class="stack" style="flex:1"><label class="small">Ping role</label>
        <select name="yt_role"><option value="">— none —</option>
          <% roles.forEach(function (r) { %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></div>
    </div>
    <label class="small">New-video message</label>
    <textarea name="yt_videoMessage" rows="2" maxlength="1500" placeholder="<%= vMsg %>"></textarea>
    <label class="small">Went-live message</label>
    <textarea name="yt_liveMessage" rows="2" maxlength="1500" placeholder="<%= lMsg %>"></textarea>
    <div><button type="button" class="link-btn" onclick="this.closest('.tw-row').remove()">remove</button></div>
  </div>
</template>
<script>
  document.getElementById('yt-add')?.addEventListener('click', function () {
    document.getElementById('yt-rows').appendChild(document.getElementById('yt-template').content.cloneNode(true));
  });
</script>
