<% var cfg = moduleConfig || {}; var feeds = Array.isArray(cfg.feeds) ? cfg.feeds : []; %>
<% var defTpl = typeof rssDefaultTemplate !== 'undefined' ? rssDefaultTemplate : '📰 **{title}**\n{link}'; %>

<p class="muted small">
  Sylo checks each feed every few minutes and posts new items to the chosen channel.
  Pick a source: a raw <strong>RSS 2.0 / Atom URL</strong> (blogs, news sites, GitHub
  <code>…/releases.atom</code>, status pages), or a <strong>Reddit</strong>, <strong>Mastodon</strong>
  or <strong>Bluesky</strong> handle — Sylo turns the handle into that platform's feed for you.
  Template placeholders: <code>{title}</code> <code>{link}</code> <code>{author}</code> <code>{feed}</code>.
  The first check only remembers the current items; new ones after that are posted (up to 15 feeds).
</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/rss/config" hx-post="/guilds/<%= guild.id %>/m/rss/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-xl">
  <div id="rss-rows">
    <% (feeds.length ? feeds : [{ id: '', type: 'url', ref: '', channelId: '', roleId: '', template: '' }]).forEach(function (f) { %>
      <div class="rss-row card stack">
        <input type="hidden" name="rss_id" value="<%= f.id || '' %>" />
        <div class="star-age">
          <div class="stack">
            <label class="small">Source</label>
            <select name="rss_type" class="rss-type">
              <option value="url"      <%= (f.type || 'url') === 'url' ? 'selected' : '' %>>RSS / Atom URL</option>
              <option value="reddit"   <%= f.type === 'reddit' ? 'selected' : '' %>>Reddit</option>
              <option value="mastodon" <%= f.type === 'mastodon' ? 'selected' : '' %>>Mastodon</option>
              <option value="bluesky"  <%= f.type === 'bluesky' ? 'selected' : '' %>>Bluesky</option>
            </select>
          </div>
          <div class="stack u-grow">
            <label class="small rss-ref-label">Feed URL</label>
            <input type="text" name="rss_ref" class="rss-ref" value="<%= f.ref || f.url || '' %>" maxlength="500" placeholder="https://example.com/feed.xml" />
          </div>
        </div>
        <div class="star-age">
          <div class="stack u-grow">
            <label class="small">Post in</label>
            <select name="rss_channel">
              <option value="">— select a channel —</option>
              <% channels.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= c.id === f.channelId ? 'selected' : '' %>>#<%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="stack u-grow">
            <label class="small">Ping role <span class="muted">— optional</span></label>
            <select name="rss_role">
              <option value="">— none —</option>
              <% roles.forEach(function (r) { %>
                <option value="<%= r.id %>" <%= r.id === f.roleId ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <label class="small">Message template <span class="muted">— blank uses the default</span></label>
        <textarea name="rss_template" rows="2" maxlength="1000" placeholder="<%= defTpl %>"><%= f.template || '' %></textarea>
        <div><button type="button" class="link-btn" onclick="this.closest('.rss-row').remove()">remove</button></div>
      </div>
    <% }) %>
  </div>
  <div><button type="button" class="secondary" id="rss-add">＋ Add feed</button></div>
  <div class="u-mt-3"><button type="submit">Save</button></div>
</form>

<template id="rss-template">
  <div class="rss-row card stack">
    <input type="hidden" name="rss_id" value="" />
    <div class="star-age">
      <div class="stack"><label class="small">Source</label>
        <select name="rss_type" class="rss-type">
          <option value="url">RSS / Atom URL</option>
          <option value="reddit">Reddit</option>
          <option value="mastodon">Mastodon</option>
          <option value="bluesky">Bluesky</option>
        </select></div>
      <div class="stack u-grow"><label class="small rss-ref-label">Feed URL</label>
        <input type="text" name="rss_ref" class="rss-ref" maxlength="500" placeholder="https://example.com/feed.xml" /></div>
    </div>
    <div class="star-age">
      <div class="stack u-grow"><label class="small">Post in</label>
        <select name="rss_channel"><option value="">— select a channel —</option>
          <% channels.forEach(function (c) { %><option value="<%= c.id %>">#<%= c.name %></option><% }) %></select></div>
      <div class="stack u-grow"><label class="small">Ping role</label>
        <select name="rss_role"><option value="">— none —</option>
          <% roles.forEach(function (r) { %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></div>
    </div>
    <label class="small">Message template</label>
    <textarea name="rss_template" rows="2" maxlength="1000" placeholder="<%= defTpl %>"></textarea>
    <div><button type="button" class="link-btn" onclick="this.closest('.rss-row').remove()">remove</button></div>
  </div>
</template>
<script>
  (function () {
    var HINTS = {
      url: ['Feed URL', 'https://example.com/feed.xml'],
      reddit: ['Subreddit or user', 'r/programming   or   u/spez'],
      mastodon: ['Handle', '@user@mastodon.social'],
      bluesky: ['Handle', 'name.bsky.social'],
    };
    function wireRow(row) {
      var sel = row.querySelector('.rss-type');
      var label = row.querySelector('.rss-ref-label');
      var input = row.querySelector('.rss-ref');
      if (!sel || !input) return;
      function sync() {
        var h = HINTS[sel.value] || HINTS.url;
        if (label) label.textContent = h[0];
        input.placeholder = h[1];
      }
      sel.addEventListener('change', sync);
      sync();
    }
    document.querySelectorAll('#rss-rows .rss-row').forEach(wireRow);
    document.getElementById('rss-add')?.addEventListener('click', function () {
      var frag = document.getElementById('rss-template').content.cloneNode(true);
      var row = frag.querySelector('.rss-row');
      document.getElementById('rss-rows').appendChild(frag);
      wireRow(row);
    });
  })();
</script>
