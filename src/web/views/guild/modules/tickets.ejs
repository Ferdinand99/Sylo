<% var cfg = moduleConfig || {}; var staff = Array.isArray(cfg.staffRoles) ? cfg.staffRoles : []; %>

<p class="muted small">Zgłoszenia wysłane na DM trafiają do prywatnych kanałów na Discordzie. Administracja odpowiada w kanale, a bot przekazuje odpowiedzi na DM użytkownika. Panel zachowuje historię rozmów.</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/tickets/config" hx-post="/guilds/<%= guild.id %>/m/tickets/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-lg">
  <h3>Discord ticket panel</h3>
  <p class="muted small">Publish an Open ticket button. It opens a topic menu visible only to the member who clicked. Each topic opens a private text channel in its selected category. Configure Staff roles below. Administrators can also access tickets. Closing sends a text transcript to the Ticket log channel, then deletes the ticket channel. If archiving fails, the channel is retained. Modmail retention does not delete Discord transcripts.</p>
  <label>Panel channel</label>
  <select name="panelChannel"><option value="">— none —</option>
  <% channels.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === cfg.panelChannel ? 'selected' : '' %>>#<%= c.name %></option><% }) %>
  </select>
  <label>Panel title</label><input name="panelTitle" maxlength="256" value="<%= cfg.panelTitle || 'Tickety pomocy' %>" />
  <label>Panel message</label><textarea name="panelText" maxlength="2000" rows="3"><%= cfg.panelText || 'Kliknij przycisk, aby wybrać temat i otworzyć prywatny ticket.' %></textarea>
  <label>Ticket log channel</label>
  <select name="ticketLogChannel"><option value="">— none —</option>
  <% channels.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === cfg.ticketLogChannel ? 'selected' : '' %>>#<%= c.name %></option><% }) %>
  </select>
  <h4>Ticket topics</h4>
  <p class="muted small">Add up to 25 topics. Save and publish after changes to update the Discord menu. One open channel ticket per member.</p>
  <div data-ticket-rows class="stack">
  <% var ticketRows = cfg.ticketTypes?.length ? cfg.ticketTypes : [{}]; ticketRows.forEach(function(row) { %>
    <fieldset class="stack" data-ticket-row>
      <input type="hidden" name="ticketTypeId" value="<%= row.id || '' %>" />
      <label>Topic name</label><input name="ticketLabel" maxlength="100" value="<%= row.label || '' %>" placeholder="Technical support" />
      <label>Description</label><input name="ticketDescription" maxlength="100" value="<%= row.description || '' %>" />
      <label>Destination category</label><select name="ticketCategory"><option value="">— choose a category —</option>
      <% categories.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === row.categoryId ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
      <button type="button" onclick="this.closest('[data-ticket-row]').remove()">Remove topic</button>
    </fieldset>
  <% }) %>
  </div>
  <template data-ticket-template>
    <fieldset class="stack" data-ticket-row>
      <input type="hidden" name="ticketTypeId" value="" />
      <label>Topic name</label><input name="ticketLabel" maxlength="100" placeholder="Technical support" />
      <label>Description</label><input name="ticketDescription" maxlength="100" />
      <label>Destination category</label><select name="ticketCategory"><option value="">— choose a category —</option>
      <% categories.forEach(function(c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
      <button type="button" onclick="this.closest('[data-ticket-row]').remove()">Remove topic</button>
    </fieldset>
  </template>
  <div><button type="button" onclick="const form=this.closest('form'); const rows=form.querySelector('[data-ticket-rows]'); if(rows.children.length &lt; 25) rows.append(form.querySelector('[data-ticket-template]').content.cloneNode(true));">Add topic</button>
  <button type="submit" name="action" value="publish">Save and publish panel</button></div>
  <hr />
  <h3>New ticket form</h3>
  <label>Form title</label><input name="formTitle" maxlength="45" value="<%= cfg.formTitle || 'Otwórz ticket' %>" />
  <p class="muted small">Add 1–5 fields. The first answer becomes the ticket title; the remaining answers become its body.</p>
  <div data-form-fields>
  <% (cfg.formFields?.length ? cfg.formFields : [{label:'Tytuł',style:'short',required:true},{label:'Opis',style:'paragraph',required:true}]).forEach(function(field) { %>
    <fieldset class="stack" data-form-field>
      <label>Field label</label><input name="formFieldLabel" maxlength="45" required value="<%= field.label %>" />
      <label>Placeholder</label><input name="formFieldPlaceholder" maxlength="100" value="<%= field.placeholder || '' %>" />
      <label>Text style</label><select name="formFieldStyle"><option value="short" <%= field.style === 'short' ? 'selected' : '' %>>Short text</option><option value="paragraph" <%= field.style !== 'short' ? 'selected' : '' %>>Long text</option></select>
      <label>Required</label><select name="formFieldRequired"><option value="yes" <%= field.required !== false ? 'selected' : '' %>>Yes</option><option value="no" <%= field.required === false ? 'selected' : '' %>>No</option></select>
      <button type="button" onclick="if(this.closest('[data-form-fields]').children.length > 1) this.closest('[data-form-field]').remove()">Remove field</button>
    </fieldset>
  <% }) %>
  </div>
  <template data-form-field-template><fieldset class="stack" data-form-field>
    <label>Field label</label><input name="formFieldLabel" maxlength="45" required />
    <label>Placeholder</label><input name="formFieldPlaceholder" maxlength="100" />
    <label>Text style</label><select name="formFieldStyle"><option value="short">Short text</option><option value="paragraph" selected>Long text</option></select>
    <label>Required</label><select name="formFieldRequired"><option value="yes">Yes</option><option value="no">No</option></select>
    <button type="button" onclick="if(this.closest('[data-form-fields]').children.length > 1) this.closest('[data-form-field]').remove()">Remove field</button>
  </fieldset></template>
  <button type="button" onclick="const form=this.closest('form'); const rows=form.querySelector('[data-form-fields]'); if(rows.children.length &lt; 5) rows.append(form.querySelector('[data-form-field-template]').content.cloneNode(true));">Add field</button>
  <hr />
  <h3>DM tickets (modmail)</h3>
  <label>Greeting sent when a ticket opens <span class="muted small">— {server} is replaced</span></label>
  <textarea name="greeting" rows="2" placeholder="Thanks for contacting the staff of {server}…"><%= cfg.greeting || '' %></textarea>

  <label>Message sent when a ticket is closed</label>
  <textarea name="closeMessage" rows="2" placeholder="This ticket has been closed…"><%= cfg.closeMessage || '' %></textarea>

  <h3>Tickety z DM na Discordzie</h3>
  <label>Kategoria zgłoszeń z DM</label>
  <select name="dmCategory"><option value="">— kategoria kanału panelu / pierwszego tematu —</option>
  <% categories.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === cfg.dmCategory ? 'selected' : '' %>><%= c.name %></option><% }) %>
  </select>
  <p class="muted small">Każdy użytkownik dostaje osobny prywatny kanał dm-ticket. Dostęp mają wybrane role administracji i administratorzy. Odpowiedzi i załączniki są przekazywane na DM. Zamknięcie zapisuje rozmowę w kanale logów ticketów, a następnie usuwa kanał. Wymagane: Zarządzanie kanałami, Zarządzanie rolami, Message Content Intent i kanał logów ticketów.</p>
  <label>Staff notification channel <span class="muted small">— optional, pinged on new tickets/replies</span></label>
  <select name="notifyChannel">
    <option value="">— none —</option>
    <% channels.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= c.id === (cfg.notifyChannel || '') ? 'selected' : '' %>>#<%= c.name %></option>
    <% }) %>
  </select>

  <label>Staff roles <span class="muted small">— may read/reply to tickets even without Manage Server</span></label>
  <%- include('../../partials/chip-picker', { field: 'staffRoles', kind: 'role', items: roles, selected: staff }) %>

  <label>Roles to ping when a ticket opens</label>
  <%- include('../../partials/chip-picker', { field: 'pingRoles', kind: 'role', items: roles, selected: cfg.pingRoles || [] }) %>
  <p class="muted small">Selected roles are mentioned in the new ticket and can read and reply there. Leave empty to disable role pings. Roles must be mentionable, or the bot needs Mention Everyone permission.</p>

  <label class="check">
    <input type="checkbox" name="showMessageInAlert" <%= cfg.showMessageInAlert ? 'checked' : '' %> />
    Include the ticket's opening message in the staff notification
  </label>
  <p class="muted small">Lets staff see what a ticket is about before opening it — off by default since the message may be sensitive.</p>

  <label>Delete closed tickets after <span class="muted small">— days; 0 = keep forever</span></label>
  <input type="number" name="transcriptRetentionDays" min="0" max="3650" value="<%= Number(cfg.transcriptRetentionDays) || 0 %>" />
  <p class="muted small">
    A daily job removes closed tickets and every message in them once they are older than this. Open tickets are never
    affected.
  </p>

  <div><button type="submit">Save</button></div>
</form>
