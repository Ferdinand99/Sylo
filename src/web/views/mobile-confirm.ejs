<%- include('partials/auth-head', { title: 'Sylo — Sign in to the app' }) %>

<section class="card auth-card">
  <h1 class="auth-title">Sign in to the Sylo app?</h1>
  <p>
    The Sylo app on your device will be signed in as <strong><%= name %></strong>
    (<%= platforms.join(' and ') %>) and can manage the same servers you manage here.
  </p>
  <p class="muted small">
    Only continue if you started this from the Sylo app yourself. You can sign the device out
    again at any time from your account page.
  </p>
  <form method="POST" action="/auth/mobile/confirm" class="auth-actions">
    <input type="hidden" name="nonce" value="<%= nonce %>" />
    <button type="submit" class="btn">Allow</button>
    <a class="btn btn-ghost" href="<%= cancelUrl %>">Cancel</a>
  </form>
</section>

<%- include('partials/auth-foot') %>
