{
  "name": "sylo",
  "version": "3.20.0",
  "description": "Multi-function Discord bot with a web dashboard and an extensible game-stats module (starting with the Battlefield series).",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node scripts/register-commands.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "discord",
    "discord-bot",
    "battlefield",
    "stats",
    "dashboard"
  ],
  "author": "Ferdinand99",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "better-sqlite3": "^13.0.3",
    "cookie-session": "^2.1.1",
    "discord.js": "^14.16.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "undici": "^6.21.0"
  }
}
