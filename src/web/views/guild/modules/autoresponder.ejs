<% var cfg = moduleConfig || {}; var list = Array.isArray(cfg.responders) ? cfg.responders : []; %>
<%
  var matchLabels = { contains: 'zawiera', exact: 'dokładnie ta wiadomość', startswith: 'zaczyna się od', wholeword: 'całe słowo' };
  var igC = Array.isArray(cfg.ignoreChannels) ? cfg.ignoreChannels : [];
  var igR = Array.isArray(cfg.ignoreRoles) ? cfg.ignoreRoles : [];
%>

<p class="muted small">
  Bot odpowiada na wybrane słowo bez komendy. Działa pierwsza pasująca reguła.
  Zmienne: <%- arPlaceholders.map(function (p) { return '<code>' + p + '</code>'; }).join(' ') %>.
  Obrazki i linki do filmów wymagają uprawnienia <strong>Osadzanie linków</strong>, a usuwanie wiadomości — <strong>Zarządzanie wiadomościami</strong>.
</p>
<p class="muted small">Filmy z Reddita i Discorda do 8 MiB bot wysyła jako załączniki; wymagają uprawnienia „Załączanie plików”. Większe pliki i inne hostingi są wysyłane jako linki. Podpisane linki mogą wygasać.</p>
<p class="muted small">Przykłady: <code>cp</code> → tekst <code>serowa pizza</code>; <code>f</code> → losowy obrazek z trzech podanych linków. Wybierz „dokładnie ta wiadomość”, aby bot nie reagował na litery wewnątrz innych słów.</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/autoresponder/config" hx-post="/guilds/<%= guild.id %>/m/autoresponder/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-2xl">
  <label>Przerwa między odpowiedziami na kanale (sekundy)</label>
  <input class="u-w-field-sm" type="number" name="cooldownSeconds" min="0" max="300" value="<%= cfg.cooldownSeconds != null ? cfg.cooldownSeconds : 2 %>" />

  <label class="u-mt-2">Automatyczne odpowiedzi</label>
  <div id="ar-rows">
    <% (list.length ? list : [{ trigger: '', match: 'exact', response: '', embed: false, deleteTrigger: false }]).forEach(function (r) { %>
      <div class="sticky-row">
        <div class="row-form">
          <input class="u-w-field" type="text" name="ar_trigger" placeholder="Słowo, np. cp lub f" value="<%= r.trigger || '' %>" />
          <select class="u-w-field-sm" name="ar_match">
            <% arMatchModes.forEach(function (m) { %>
              <option value="<%= m %>" <%= m === (r.match || 'contains') ? 'selected' : '' %>><%= matchLabels[m] || m %></option>
            <% }) %>
          </select>
          <select class="u-w-field-sm" name="ar_embed">
            <option value="text" <%= r.embed ? '' : 'selected' %>>Tekst</option>
            <option value="embed" <%= r.embed ? 'selected' : '' %>>Embed</option>
          </select>
          <select class="u-w-field-sm" name="ar_delete">
            <option value="keep" <%= r.deleteTrigger ? '' : 'selected' %>>Zachowaj wiadomość</option>
            <option value="delete" <%= r.deleteTrigger ? 'selected' : '' %>>Usuń wiadomość</option>
          </select>
          <button type="button" class="link-btn" onclick="this.closest('.sticky-row').remove()">Usuń</button>
        </div>
        <label class="small">Rodzaj odpowiedzi</label>
        <select name="ar_response_type">
          <option value="text" <%= ['random-image', 'random-media'].includes(r.responseType) ? '' : 'selected' %>>Stały tekst</option>
          <option value="random-media" <%= ['random-image', 'random-media'].includes(r.responseType) ? 'selected' : '' %>>Losowy obrazek lub film</option>
        </select>
        <label class="small">Treść odpowiedzi (przy mediach: opcjonalny podpis)</label>
        <textarea name="ar_response" rows="2" placeholder="Np. serowa pizza"><%= r.response || '' %></textarea>
        <label class="small">Linki do obrazków lub filmów — każdy w osobnym wierszu (maks. 25)</label>
        <textarea name="ar_images" rows="3" placeholder="https://example.com/obrazek1.png&#10;https://example.com/obrazek2.png&#10;https://example.com/obrazek3.png"><%= Array.isArray(r.imageUrls) ? r.imageUrls.join('\n') : '' %></textarea>
        <p class="muted small">W trybie „Losowy obrazek lub film” bot wysyła jeden wylosowany obrazek lub film. Podaj bezpośrednie linki do plików PNG/JPG/GIF lub MP4/WebM, a nie strony z mediami.</p>
      </div>
    <% }) %>
  </div>
  <div><button type="button" class="secondary" id="ar-add" data-ar-add>+ Dodaj odpowiedź</button></div>

  <label class="u-mt-3">Ignorowane kanały</label>
  <%- include('../../partials/chip-picker', { field: 'ignoreChannels', kind: 'channel', items: channels, selected: igC }) %>
  <label class="u-mt-2">Ignorowane role</label>
  <%- include('../../partials/chip-picker', { field: 'ignoreRoles', kind: 'role', items: roles, selected: igR }) %>

  <div class="u-mt-3"><button type="submit">Zapisz</button></div>

<template id="ar-template" data-ar-template>
  <div class="sticky-row">
    <div class="row-form">
      <input class="u-w-field" type="text" name="ar_trigger" placeholder="Słowo, np. cp lub f" />
      <select class="u-w-field-sm" name="ar_match">
        <% arMatchModes.forEach(function (m) { %><option value="<%= m %>" <%= m === "exact" ? "selected" : "" %>><%= matchLabels[m] || m %></option><% }) %>
      </select>
      <select class="u-w-field-sm" name="ar_embed"><option value="text" selected>Tekst</option><option value="embed">Embed</option></select>
      <select class="u-w-field-sm" name="ar_delete"><option value="keep" selected>Zachowaj wiadomość</option><option value="delete">Usuń wiadomość</option></select>
      <button type="button" class="link-btn" onclick="this.closest('.sticky-row').remove()">Usuń</button>
    </div>
    <label class="small">Rodzaj odpowiedzi</label>
    <select name="ar_response_type"><option value="text">Stały tekst</option><option value="random-media">Losowy obrazek lub film</option></select>
    <label class="small">Treść odpowiedzi (przy mediach: opcjonalny podpis)</label>
    <textarea name="ar_response" rows="2" placeholder="Np. serowa pizza"></textarea>
    <label class="small">Linki do obrazków lub filmów — każdy w osobnym wierszu (maks. 25)</label>
    <textarea name="ar_images" rows="3" placeholder="https://example.com/obrazek1.png&#10;https://example.com/obrazek2.png&#10;https://example.com/obrazek3.png"></textarea>
    <p class="muted small">W trybie „Losowy obrazek lub film” bot wysyła jeden wylosowany obrazek lub film. Podaj bezpośrednie linki do plików.</p>
  </div>
</template>
</form>
