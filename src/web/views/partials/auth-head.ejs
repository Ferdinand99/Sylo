<%# The head of the standalone public pages that share the auth card layout (login, the app's
    confirm page, the error page): a page of their own, without any dashboard shell, sidebar or
    framework scripts. /theme.js has to be a plain script in <head> so the saved theme is applied
    before first paint; there is no inline script on purpose. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Sylo' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/public.css" />
  <script src="/telemetry.js" async></script>
</head>
<body>
  <main class="auth-wrap">
    <div class="auth-brand">
      <img src="/favicon.svg" alt="" width="36" height="36" />
      <span>Sylo</span>
    </div>
