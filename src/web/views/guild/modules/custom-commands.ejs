<% var cfg = moduleConfig || {}; var cmds = Array.isArray(cfg.commands) ? cfg.commands : []; %>

<p class="muted small">
  Commands work in chat as <code><%= cfg.prefix || '!' %>name</code><% if (cfg.slash) { %> and as <code>/name</code><% } %>.
  Placeholders in the response / embed title:
  <%= ccPlaceholders.map(function (p) { return '<code>' + p + '</code>'; }).join(' ') %>
  (<code>{args}</code> = text after the command name; for a slash command it becomes a <code>text:</code> option).
</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/custom-commands/config" class="stack" style="max-width:680px">
  <label>Prefix</label>
  <input type="text" name="prefix" maxlength="5" value="<%= cfg.prefix || '!' %>" style="width:80px" />

  <label class="check" style="margin-top:6px">
    <input type="checkbox" name="slash" <%= cfg.slash ? 'checked' : '' %> />
    Also register these as slash commands (<code>/name</code>) — synced to Discord on save
  </label>

  <label style="margin-top:8px">Commands</label>
  <div id="cc-rows">
    <% (cmds.length ? cmds : [{ name: '', response: '', embed: false, embedTitle: '', embedColor: '5b7cfa' }]).forEach(function (c) { %>
      <div class="sticky-row">
        <div class="row-form">
          <input type="text" name="cc_name" placeholder="name" value="<%= c.name || '' %>" style="width:150px" />
          <select name="cc_type" style="width:110px">
            <option value="text" <%= c.embed ? '' : 'selected' %>>Text</option>
            <option value="embed" <%= c.embed ? 'selected' : '' %>>Embed</option>
          </select>
          <input type="text" name="cc_embedTitle" placeholder="embed title (optional)" value="<%= c.embedTitle || '' %>" class="grow" />
          <input type="color" name="cc_embedColor" value="#<%= (c.embedColor || '5b7cfa').replace('#','') %>" title="Embed colour" />
          <button type="button" class="link-btn" onclick="this.closest('.sticky-row').remove()">remove</button>
        </div>
        <textarea name="cc_response" rows="2" placeholder="Reply text…"><%= c.response || '' %></textarea>
      </div>
    <% }) %>
  </div>
  <div><button type="button" class="secondary" id="cc-add">+ Add command</button></div>
  <div style="margin-top:10px"><button type="submit">Save</button></div>
</form>

<template id="cc-template">
  <div class="sticky-row">
    <div class="row-form">
      <input type="text" name="cc_name" placeholder="name" style="width:150px" />
      <select name="cc_type" style="width:110px">
        <option value="text" selected>Text</option>
        <option value="embed">Embed</option>
      </select>
      <input type="text" name="cc_embedTitle" placeholder="embed title (optional)" class="grow" />
      <input type="color" name="cc_embedColor" value="#5b7cfa" title="Embed colour" />
      <button type="button" class="link-btn" onclick="this.closest('.sticky-row').remove()">remove</button>
    </div>
    <textarea name="cc_response" rows="2" placeholder="Reply text…"></textarea>
  </div>
</template>
<script>
  document.getElementById('cc-add')?.addEventListener('click', () => {
    document.getElementById('cc-rows').appendChild(document.getElementById('cc-template').content.cloneNode(true));
  });
</script>
