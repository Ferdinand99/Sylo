<%- include('partials/header', { title: 'Sylo — Dashboard' }) %>

<h1 class="page-title">Choose a server</h1>
<p class="muted">Pick a server to manage its plugins.</p>

<% if (servers.length === 0) { %>
  <p class="muted">No servers found. Invite Sylo to a server where you have <strong>Manage Server</strong>,
    then reload. Bot health is on the <a href="/health">Health</a> page.</p>
<% } else { %>
  <div class="server-picker">
    <% servers.forEach(function (g) { %>
      <a class="server-pick" href="/guilds/<%= g.id %>/overview">
        <% if (g.icon) { %><img src="<%= g.icon %>" alt="" /><% } else { %><span class="server-pick-ph"><%= g.name.charAt(0) %></span><% } %>
        <span class="server-pick-name"><%= g.name %></span>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
