<%- include('partials/header', { title: `Sylo — ${guild.name}` }) %>

<p class="muted"><a href="/">&larr; Dashboard</a></p>
<div class="guild-head">
  <% if (guild.icon) { %><img class="guild-icon" src="<%= guild.icon %>" alt="" /><% } %>
  <div>
    <h1 class="page-title"><%= guild.name %></h1>
    <p class="muted"><%= guild.memberCount %> members · <span class="mono"><%= guild.id %></span></p>
  </div>
</div>

<% if (typeof msg !== 'undefined' && msg) {
     const messages = {
       saved: 'Saved.', cleared: 'Mod-log logging disabled.',
       badchannel: 'That channel is not a usable text channel.',
       badcommand: 'Unknown command.',
       perms: 'The bot lacks View Channel / Send Messages / Embed Links there.',
       warned: 'Warning added.',
       'warned-nolog': 'Warning added — no mod-log channel is set, so it was not logged.',
       baduser: 'Enter a valid user ID (or @mention) and a reason.',
       botuser: "You can't warn a bot.",
       unbanned: 'Ban removed.',
       notbanned: 'That user is not banned.',
       needpair: 'Add at least one emoji → role pair.',
       rrfail: 'Could not post the reaction-role message (check the bot\'s permissions in that channel).',
       'count-set': 'Counting number updated.',
       'count-reset': 'Counting reset to 0.',
       'count-bad': 'Enter a whole number of 0 or more.',
       'sched-bad': 'Enter a message and an interval between 1 minute and 4 weeks.',
       'lvl-set': 'Member XP updated.',
       'lvl-reset': 'Leveling data cleared for this server.',
       'lvl-bad': 'Enter a valid user ID (or @mention) and an XP amount of 0 or more.',
       'appeal-accepted': 'Appeal accepted — the member was DM\'d and can see it on their appeal link.',
       'appeal-denied': 'Appeal denied — the member was DM\'d and can see it on their appeal link.',
       'appeal-accepted-nodm': 'Appeal accepted. Sylo could not DM the member (no shared server) — they will see the decision and a rejoin invite on their appeal link.',
       'appeal-denied-nodm': 'Appeal denied. Sylo could not DM the member (no shared server) — they will see the decision on their appeal link.',
       'appeal-gone': 'That appeal was already decided or withdrawn.',
       'appeal-bad': 'Choose accept or deny.',
       'wc-published': 'Welcome message published to the channel.',
       'wc-channel': 'Created a read-only #welcome channel.',
       'wc-unpub': 'Removed the published welcome message.',
       'wc-fail': 'That did not work — check the bot has Send Messages / Embed Links (and Manage Channels to create one).',
       'sb-saved': 'Board saved — scanning recent messages for anything that already clears the threshold.',
       'cc-bad': 'The command could not be read — please try again.',
       'cc-name': 'Enter a name with only lowercase letters, numbers, - and _ (max 32).',
       'cc-reserved': 'That name is a built-in Sylo command — pick another.',
       'cc-dupe': 'A custom command with that name already exists in this server.',
       'cc-empty': 'Add at least one action that replies, posts a message, or changes a role.',
       'inv-bad': 'Enter a valid member ID (or @mention) and a whole-number bonus.',
     };
     const ok = ['saved', 'cleared', 'warned', 'unbanned', 'count-set', 'count-reset', 'lvl-set', 'lvl-reset', 'appeal-accepted', 'appeal-denied', 'wc-published', 'wc-channel', 'wc-unpub', 'sb-saved'].includes(msg);
     const cls = ok ? 'ok' : (msg === 'warned-nolog' || /^appeal-(accepted|denied)-nodm$/.test(msg) ? 'info' : 'bad');
%>
  <div class="banner <%= cls %>"><%= messages[msg] || 'Done.' %></div>
<% } %>

<div class="guild-wrap">
  <% if (panel === 'overview') { %>
    <% var h = overview.health; %>
    <% var issues = []; %>
    <% if (!h.perms.ok) { issues.push('Missing bot permission: ' + h.perms.missing.join(', ')); } %>
    <% if (h.intents.membersBlocking || h.intents.contentBlocking) { issues.push('An enabled plugin needs a privileged intent that is turned off'); } %>
    <% if (!h.modlog.set) { issues.push('No mod-log channel set (General settings)'); } %>

    <div class="plugin-head">
      <p class="muted"><%= h.modules.enabled %> of <%= h.modules.total %> plugins enabled<% if (h.tickets.open) { %> &middot; <%= h.tickets.open %> open ticket<%= h.tickets.open === 1 ? '' : 's' %><% } %></p>
      <a class="plugin-head-link" href="/health">Bot health &rarr;</a>
    </div>

    <% if (issues.length) { %>
      <div class="banner bad plugin-issues">
        <strong>Needs attention</strong>
        <ul><% issues.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
      </div>
    <% } %>

    <% overview.groups.forEach(function (group) { %>
      <h3 class="plugin-group"><%= group.title %></h3>
      <div class="plugin-grid">
        <% group.cards.forEach(function (c) { %>
          <div class="plugin-card is-<%= c.status %>">
            <a class="plugin-hit" href="<%= c.href %>" aria-label="<%= c.name %>"></a>
            <span class="plugin-ico"><svg class="plugin-ico-svg" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-<%= c.icon %>"/></svg></span>
            <span class="plugin-name"><%= c.name %></span>
            <span class="plugin-desc"><%= c.description %></span>
            <span class="plugin-cta" data-guild="<%= guild.id %>" data-module="<%= c.id %>">
              <% if (c.status === 'blocked') { %>
                <span class="plugin-btn blocked" title="Needs the <%= c.missingIntents.join(', ') %> intent">Needs intent</span>
              <% } else if (!c.hasToggle) { %>
                <span class="plugin-btn open">Open &rarr;</span>
              <% } else if (c.enabled) { %>
                <a class="plugin-btn active" href="<%= c.href %>">✓ Active</a>
              <% } else { %>
                <button type="button" class="plugin-btn enable" data-guild="<%= guild.id %>" data-module="<%= c.id %>" data-config="<%= c.href %>">+ Enable</button>
              <% } %>
            </span>
          </div>
        <% }) %>
      </div>
    <% }) %>

  <% } else { %>
  <section class="guild-panel">
    <% if (panel === 'settings') { %>
      <h2>Settings</h2>
      <p class="muted">Server-wide settings for Sylo. Bot-identity (name, avatar, activity) lives in <a href="/settings">Bot Personalizer</a>.</p>

      <form method="POST" action="/guilds/<%= guild.id %>/settings" class="stack" style="max-width:560px">
        <h3 style="margin:14px 0 2px">Bot masters</h3>
        <p class="muted small">Roles that can manage Sylo's dashboard for this server — full control, so give it
          only to trusted staff. They reach the dashboard via a direct link.</p>

        <label class="small">Administrator roles <span class="muted">— automatic</span></label>
        <div class="role-chips is-readonly">
          <% if (adminRoles.length === 0) { %>
            <span class="muted small">No role has the Administrator permission.</span>
          <% } %>
          <% adminRoles.forEach(function (r) { %>
            <span class="role-chip"><span class="role-dot" style="background:<%= r.color || 'var(--muted)' %>"></span><%= r.name %></span>
          <% }) %>
        </div>
        <p class="muted small">Any role with the Administrator permission is always a bot master.</p>

        <label class="small" style="margin-top:8px">Additional bot master roles</label>
        <div class="role-picker" data-field="botMasterRoles">
          <div class="role-chips" data-role-chips>
            <% botMasters.forEach(function (r) { %>
              <span class="role-chip" data-id="<%= r.id %>" data-name="<%= r.name %>" data-color="<%= r.color || '' %>">
                <span class="role-dot" style="background:<%= r.color || 'var(--muted)' %>"></span><%= r.name %>
                <button type="button" class="role-chip-x" aria-label="Remove">&times;</button>
                <input type="hidden" name="botMasterRoles" value="<%= r.id %>" />
              </span>
            <% }) %>
          </div>
          <select class="role-picker-add">
            <option value="">+ Add a role…</option>
            <% rolePool.forEach(function (r) { %>
              <option value="<%= r.id %>" data-name="<%= r.name %>" data-color="<%= r.color || '' %>"><%= r.name %></option>
            <% }) %>
          </select>
        </div>

        <h3 style="margin:16px 0 2px">Moderation log channel</h3>
        <select name="modlogChannelId">
          <option value="">— disabled —</option>
          <% channels.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= c.id === modlogChannelId ? 'selected' : '' %>>#<%= c.name %></option>
          <% }) %>
        </select>

        <h3 style="margin:16px 0 2px">Default embed colour</h3>
        <p class="muted small">Used for Sylo's branded embeds (welcome messages and more).</p>
        <div class="settings-color">
          <input type="color" name="embedColor" value="<%= embedColorHex %>" />
          <label class="checkline"><input type="checkbox" name="embedColorReset" /> Reset to Sylo blue</label>
        </div>

        <div style="margin-top:14px"><button type="submit">Save settings</button></div>
      </form>

      <hr class="sep" />
      <h3 style="margin-bottom:4px">Backup</h3>
      <p class="muted small">Download this server's module configuration as JSON. Member data (warnings, XP, tickets) is not included.</p>
      <p><a href="/guilds/<%= guild.id %>/export">Export configuration &rarr;</a></p>

    <% } else if (panel === 'audit') { %>
      <h2>Audit log</h2>
      <p class="muted">Configuration changes made from this dashboard. Keeps the most recent 500 per server.</p>
      <% if (audit.length === 0) { %>
        <p class="muted">Nothing recorded yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Detail</th></tr></thead>
          <tbody>
            <% audit.forEach(function (a) { %>
              <tr>
                <td class="muted"><%= a.ago %></td>
                <td><%= a.actor %></td>
                <td class="mono"><%= a.action %></td>
                <td class="muted"><%= a.detail %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

    <% } else if (panel === 'commands') { %>
      <h2>Commands</h2>
      <%- include('guild/commands', { guild: guild, commands: commands, roles: roles, channels: channels }) %>

    <% } else if (panel === 'moderation') { %>
      <h2>Moderator</h2>
      <p class="muted">Auto-moderation, warning auto-actions, infractions, immunity, audit logging and command permissions.</p>

      <div class="mod-tabbed">
        <input type="radio" name="mtab" id="mt-automod" checked />
        <input type="radio" name="mtab" id="mt-actions" />
        <input type="radio" name="mtab" id="mt-admin" />
        <input type="radio" name="mtab" id="mt-infr" />
        <input type="radio" name="mtab" id="mt-log" />
        <input type="radio" name="mtab" id="mt-cmd" />
        <div class="mod-tablabels">
          <label for="mt-automod">Automod</label>
          <label for="mt-actions">Auto-actions</label>
          <label for="mt-admin">Admin</label>
          <label for="mt-infr">Infractions</label>
          <label for="mt-log">Audit logging</label>
          <label for="mt-cmd">Commands</label>
        </div>
        <div class="mod-panels">
          <div class="mod-panel" data-tab="automod">
            <%- include('guild/modules/automod', { guild: guild, channels: channels, roles: roles, moduleConfig: automodConfig, automodRules: automodRules }) %>
          </div>
          <div class="mod-panel" data-tab="admin">
            <h3 style="margin-top:0">Immunity roles</h3>
            <p class="muted small">Members with one of these roles are never touched by Auto-moderation or the
              warning auto-actions. Administrators, the server owner and bot-master roles are immune by default.</p>
            <form method="POST" action="/guilds/<%= guild.id %>/m/automod/immunity" class="stack" style="max-width:520px">
              <%- include('partials/chip-picker', { field: 'immunityRoles', kind: 'role', items: roles, selected: (automodConfig && automodConfig.exemptRoles) ? automodConfig.exemptRoles : [] }) %>
              <div style="margin-top:12px"><button type="submit">Save immunity roles</button></div>
            </form>
          </div>
          <div class="mod-panel" data-tab="actions">
            <p class="muted small">Automatically time out / kick / ban a member when their warning count hits a threshold. Immunity roles are skipped.</p>
            <%- include('guild/modules/moderation', { guild: guild, moduleConfig: moderationCfg, thresholdActions: thresholdActions }) %>
          </div>
          <div class="mod-panel" data-tab="infr">
            <%- include('guild/moderation', { guild: guild, warnings: warnings, warningTotal: warningTotal, warningShown: warningShown, bans: bans, bansTotal: bansTotal, bansShown: bansShown, bansError: bansError, banLimit: banLimit }) %>
          </div>
          <div class="mod-panel" data-tab="log">
            <p class="muted small">Send server events to a channel. Set the mod-log channel (for moderation actions) under <a href="/guilds/<%= guild.id %>/settings">Settings</a>.</p>
            <%- include('guild/modules/logging', { guild: guild, channels: channels, moduleConfig: loggingCfg, logEvents: logEvents }) %>
          </div>
          <div class="mod-panel" data-tab="cmd">
            <%- include('guild/commands', { guild: guild, commands: commands, roles: roles, channels: channels }) %>
          </div>
        </div>
      </div>

    <% } else if (panel === 'leaderboard') { %>
      <div class="module-panel-head">
        <h2>🏆 Leaderboard</h2>
        <a class="btn btn-primary" href="/leaderboard/<%= guild.id %>" target="_blank" rel="noopener">See leaderboard &rarr;</a>
      </div>
      <p class="muted">Every minute a member is chatting they earn a random amount of XP. Rankings come from the <a href="/guilds/<%= guild.id %>/m/leveling">Leveling</a> module.</p>
      <% if (!levelingEnabled) { %>
        <div class="banner info">Leveling is off — <a href="/guilds/<%= guild.id %>/m/leveling">enable it</a> to track XP and publish a leaderboard.</div>
      <% } %>

      <hr class="sep" />
      <form method="POST" action="/guilds/<%= guild.id %>/leaderboard/public" class="lb-public">
        <div>
          <strong>Make this server's leaderboard public</strong>
          <p class="muted small">Anyone with the link can view it at <code>/leaderboard/<%= guild.id %></code> — no login. Search engines may index it.</p>
        </div>
        <label class="switch">
          <input type="checkbox" name="publicLeaderboard" onchange="this.form.submit()" <%= publicLeaderboard ? 'checked' : '' %> />
          <span class="slider"></span>
        </label>
        <noscript><button type="submit">Save</button></noscript>
      </form>

      <hr class="sep" />
      <h3 style="margin-bottom:6px">Top members <span class="muted small">(<%= board.total %> tracked)</span></h3>
      <% if (board.rows.length === 0) { %>
        <p class="muted">No XP recorded yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>#</th><th>Member</th><th class="num">Level</th><th class="num">XP</th><th class="num">Messages</th></tr></thead>
          <tbody>
            <% board.rows.forEach(function (r) { %>
              <tr>
                <td><%= r.rank %></td>
                <td><%= r.name %></td>
                <td class="num"><%= r.level %></td>
                <td class="num"><%= r.xp.toLocaleString('en') %></td>
                <td class="num"><%= r.messages.toLocaleString('en') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

    <% } else if (panel === 'appeals') { %>
      <h2>⚖️ Ban appeals</h2>
      <p class="muted">Banned members are DM'd a link to an appeal form. Accept or deny each one with a reason — Sylo DMs the member the outcome, and accepting lifts the ban automatically when that option is on.</p>
      <% if (!appealsModuleEnabled) { %>
        <div class="banner info">The <strong>Ban appeals</strong> module is off. <a href="/guilds/<%= guild.id %>/m/appeals">Enable and configure it</a> to start collecting appeals.</div>
      <% } %>

      <% if (appeals.length === 0) { %>
        <p class="muted">No appeals yet.</p>
      <% } else { %>
        <% appeals.forEach(function (a) { %>
          <div class="cmd-override">
            <div class="cmd-override-head">
              <span><strong><%= a.user %></strong> <span class="mono muted">(<%= a.userId %>)</span></span>
              <span class="pill <%= a.status === 'open' ? 'open' : (a.status === 'accepted' ? 'on' : 'off') %>"><%= a.status %></span>
            </div>
            <p class="muted small">Submitted <%= a.ago %> · original ban reason: <%= a.banReason %></p>
            <dl class="appeal-answers">
              <% a.answers.forEach(function (qa) { %>
                <dt class="small"><%= qa.q %></dt>
                <dd><%= qa.a || '—' %></dd>
              <% }) %>
            </dl>
            <% if (a.status === 'open') { %>
              <form method="POST" action="/guilds/<%= guild.id %>/appeals/<%= a.id %>/decide" class="stack">
                <label class="small">Reason / note to the member</label>
                <textarea name="reason" rows="2" maxlength="1000" placeholder="Explain the decision — the member sees this."></textarea>
                <div class="btn-row">
                  <button type="submit" name="decision" value="accept">Accept &amp; unban</button>
                  <button type="submit" name="decision" value="deny" class="danger">Deny</button>
                </div>
              </form>
            <% } else { %>
              <p class="muted small">
                <%= a.status === 'accepted' ? 'Accepted' : 'Denied' %> <%= a.decidedAgo %> by <%= a.decidedBy || '—' %><% if (a.decisionReason) { %> — “<%= a.decisionReason %>”<% } %>
              </p>
            <% } %>
          </div>
        <% }) %>
      <% } %>

    <% } else if (panel.indexOf('m/') === 0 && typeof activeModule !== 'undefined') { %>
      <% var mrow = modules.find(function (x) { return x.id === activeModule.id; }); %>
      <div class="module-panel-head">
        <h2><%= activeModule.icon %> <%= activeModule.name %></h2>
        <label class="switch">
          <input type="checkbox" class="module-toggle" data-guild="<%= guild.id %>" data-module="<%= activeModule.id %>"
            <%= mrow.enabled ? 'checked' : '' %> <%= mrow.missingIntents.length ? 'disabled' : '' %> />
          <span class="slider"></span>
        </label>
      </div>
      <p class="muted"><%= activeModule.description %></p>
      <% if (mrow.missingIntents.length) { %>
        <p class="warn-text small">Needs intent: <%= mrow.missingIntents.join(', ') %> — enable it in the Discord Developer Portal.</p>
      <% } %>
      <% if (!mrow.enabled) { %><p class="muted small">Enable the module (toggle above) for these settings to take effect.</p><% } %>
      <hr class="sep" />
      <%- include(configView, { guild: guild, channels: channels, moduleConfig: moduleConfig, activeModule: activeModule, roles: (typeof roles !== 'undefined' ? roles : []), logEvents: (typeof logEvents !== 'undefined' ? logEvents : []), welcomePlaceholders: (typeof welcomePlaceholders !== 'undefined' ? welcomePlaceholders : []), thresholdActions: (typeof thresholdActions !== 'undefined' ? thresholdActions : []), automodRules: (typeof automodRules !== 'undefined' ? automodRules : []), automodActions: (typeof automodActions !== 'undefined' ? automodActions : []), countingState: (typeof countingState !== 'undefined' ? countingState : null), ccPlaceholders: (typeof ccPlaceholders !== 'undefined' ? ccPlaceholders : []), arPlaceholders: (typeof arPlaceholders !== 'undefined' ? arPlaceholders : []), arMatchModes: (typeof arMatchModes !== 'undefined' ? arMatchModes : []), reminders: (typeof reminders !== 'undefined' ? reminders : []), schedulePresets: (typeof schedulePresets !== 'undefined' ? schedulePresets : []), announceModes: (typeof announceModes !== 'undefined' ? announceModes : []), xpRates: (typeof xpRates !== 'undefined' ? xpRates : []), levelingCommands: (typeof levelingCommands !== 'undefined' ? levelingCommands : []), levelingBoard: (typeof levelingBoard !== 'undefined' ? levelingBoard : null), verifyModes: (typeof verifyModes !== 'undefined' ? verifyModes : []), turnstileEnabled: (typeof turnstileEnabled !== 'undefined' ? turnstileEnabled : false), twitchEnabled: (typeof twitchEnabled !== 'undefined' ? twitchEnabled : false), twitchDefaultMessage: (typeof twitchDefaultMessage !== 'undefined' ? twitchDefaultMessage : ''), ytVideoMessage: (typeof ytVideoMessage !== 'undefined' ? ytVideoMessage : ''), ytLiveMessage: (typeof ytLiveMessage !== 'undefined' ? ytLiveMessage : ''), voiceChannels: (typeof voiceChannels !== 'undefined' ? voiceChannels : []), categories: (typeof categories !== 'undefined' ? categories : []), statTypes: (typeof statTypes !== 'undefined' ? statTypes : []), dashboardUrlSet: (typeof dashboardUrlSet !== 'undefined' ? dashboardUrlSet : false), welcomeAutoroles: (typeof welcomeAutoroles !== 'undefined' ? welcomeAutoroles : []), verificationEnabled: (typeof verificationEnabled !== 'undefined' ? verificationEnabled : false), wcPresets: (typeof wcPresets !== 'undefined' ? wcPresets : []), giveaways: (typeof giveaways !== 'undefined' ? giveaways : []) }) %>
    <% } %>
  </section>
  <% } %>
</div>

<%- include('partials/footer') %>
