<%- include('partials/header', { title: `Sylo — Embed messages — ${guild.name}` }) %>

<p class="muted"><a href="/guilds/<%= guild.id %>/overview">&larr; <%= guild.name %></a></p>

<div class="rr-builder-head">
  <h1 class="page-title">Embed messages</h1>
  <a class="btn btn-primary" href="/guilds/<%= guild.id %>/messages/new">＋ New embed message</a>
</div>
<p class="muted small">Build rich embed messages with a live editor, then publish them to a channel as Sylo — and re-publish to edit the posted message in place.</p>

<% if (msg) {
     var known = { saved: 'Saved.', sent: 'Published to the channel.', updated: 'The published message was updated.', unpublished: 'Removed the published message — the draft is kept.', deleted: 'Deleted in Discord and removed from the list.', removed: 'Removed from the list (the Discord message could not be deleted — it may already be gone).', bad: 'Could not read the editor — try again.', nochannel: 'Pick a channel before publishing.' };
     var text = known[msg];
     if (!text) { try { text = decodeURIComponent(msg); } catch (_) { text = msg; } }
%>
  <div class="banner <%= (['saved','sent','updated','deleted'].indexOf(msg) >= 0) ? 'ok' : (['unpublished','removed'].indexOf(msg) >= 0 ? 'info' : 'bad') %>"><%= text %></div>
<% } %>

<div class="rr-list-head u-mt-3">
  <h3 class="u-m0">Your embed messages <span class="muted small"><%= items.length %> / 200</span></h3>
</div>

<% if (items.length === 0) { %>
  <p class="muted small">None yet — create one to post an embed to a channel.</p>
<% } else { %>
  <% items.forEach(function (it) { %>
    <div class="cmd-override">
      <div class="cmd-override-head">
        <span>
          <strong><%= it.name %></strong>
          <span class="muted small">· #<%= it.channel %> · edited <%= it.when %></span>
        </span>
        <span class="pill <%= it.published ? 'on' : 'off' %>"><%= it.published ? 'published' : 'draft' %></span>
      </div>
      <div class="btn-row">
        <a class="plugin-btn" href="/guilds/<%= guild.id %>/messages/<%= it.id %>">Edit</a>
        <% if (it.published) { %>
          <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/messages/<%= it.id %>/unpublish">
            <button type="submit" data-confirm="Delete the posted message? The draft stays here.">Unpublish</button>
          </form>
        <% } %>
        <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/messages/<%= it.id %>/delete">
          <button type="submit" class="danger" data-confirm="Delete this embed message (and the posted message, if any)?">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>

<%- include('partials/footer') %>
