<%- include('partials/header', { title: `Sylo — ${isNew ? 'New' : 'Edit'} cleanup schedule` }) %>

<p class="muted"><a href="/guilds/<%= guildId %>/m/channel-cleanup">&larr; Channel cleanup</a></p>

<div class="rr-builder-head">
  <h2 class="u-m0"><%= isNew ? 'New' : 'Edit' %> cleanup schedule</h2>
  <div class="rr-actions">
    <a class="btn" href="/guilds/<%= guildId %>/m/channel-cleanup">Discard</a>
    <button type="submit" form="cc-form" class="btn btn-primary">Save &amp; close</button>
  </div>
</div>

<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="banner banner-flash <%= (['saved'].indexOf(msg) >= 0) ? 'ok' : 'bad' %>">
    <%= ({ saved: 'Saved.', badchannel: 'Pick a channel.', 'cc-time': 'Pick a valid time.' })[msg] || (function(){ try { return decodeURIComponent(msg); } catch(e){ return msg; } })() %>
  </div>
<% } %>

<form method="POST" action="/guilds/<%= guildId %>/m/channel-cleanup/s/<%= isNew ? 'new' : rec.id %>" id="cc-form" hx-boost="false" class="stack u-mw-xl">
  <section class="card stack">
    <h2 class="u-m0">Channel</h2>
    <select class="u-mw-md" name="channelId" required>
      <option value="">— select a channel —</option>
      <% channels.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= c.id === rec.channel_id ? 'selected' : '' %>>#<%= c.name %></option>
      <% }) %>
    </select>
  </section>

  <section class="card stack">
    <h2 class="u-m0">Schedule</h2>

    <label class="small">Run on</label>
    <div class="rem-days">
      <% weekdays.forEach(function (d) { var on = (rec.dayList || []).indexOf(d[0]) !== -1; %>
        <label class="rem-day <%= on ? 'on' : '' %>" x-data="{ on: <%= on ? 'true' : 'false' %> }" :class="{ on }">
          <input type="checkbox" name="day_<%= d[0] %>" <%= on ? 'checked' : '' %> @change="on = $event.target.checked" /> <%= d[1] %>
        </label>
      <% }) %>
    </div>

    <label class="small u-mt-2">At (server local time)</label>
    <input class="u-mw-xs" type="time" name="timeHhmm" value="<%= rec.time_hhmm %>" required />
  </section>

  <section class="card stack">
    <h2 class="u-m0">What to delete</h2>
    <label class="small">Delete messages older than</label>
    <input class="u-mw-xs" type="number" name="maxAgeHours" min="1" max="2160" value="<%= rec.max_age_hours %>" required />
    <span class="muted small">hours (2,160 = 90 days max)</span>
    <label class="checkline u-mt-2">
      <input type="checkbox" name="skipPinned" <%= rec.skip_pinned ? 'checked' : '' %> /> Never delete pinned messages
    </label>
    <p class="muted small u-mt-2">
      Runs in batches; messages under 14 days old are bulk-deleted, older ones one at a time (capped per
      run so a large backlog catches up over a few runs instead of one long operation).
    </p>
  </section>
</form>

<%- include('partials/footer') %>
