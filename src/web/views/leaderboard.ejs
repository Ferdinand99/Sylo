<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= guild.name %> — Leaderboard</title>
  <% if (typeof canonical !== 'undefined' && canonical) { %><link rel="canonical" href="<%= canonical %>" /><% } %>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="lb-wrap">
    <header class="lb-head">
      <% if (guild.icon) { %><img class="lb-guild-icon" src="<%= guild.icon %>" alt="" /><% } %>
      <div>
        <h1 class="page-title"><%= guild.name %></h1>
        <p class="muted">Leveling leaderboard · <%= total %> ranked member<%= total === 1 ? '' : 's' %></p>
      </div>
    </header>

    <% var lbPeriod = typeof period !== 'undefined' ? period : 'all'; %>
    <% var pq = function (p) { return p === 'all' ? '?' : '?period=' + p; }; %>
    <% var hm = function (m) { m = Math.max(0, Math.round(m || 0)); return m < 60 ? m + 'm' : (Math.floor(m / 60) + 'h ' + (m % 60) + 'm'); }; %>
    <nav class="lb-periods">
      <% [['all','All time'],['week','This week'],['month','This month']].forEach(function (p) { %>
        <a class="<%= lbPeriod === p[0] ? 'on' : '' %>" href="<%= pq(p[0]) %>"><%= p[1] %></a>
      <% }) %>
    </nav>

    <% if (members.length === 0) { %>
      <div class="card"><p class="muted"><%= lbPeriod === 'all' ? 'No one has earned any XP yet.' : 'No XP earned in this period yet.' %></p></div>
    <% } else { %>
      <ol class="lb-list">
        <% members.forEach(function (m) { %>
          <li class="lb-row<%= m.rank <= 3 ? ' lb-top' : '' %>">
            <span class="lb-rank">#<%= m.rank %></span>
            <% if (m.avatar) { %><img class="lb-avatar" src="<%= m.avatar %>" alt="" /><% } else { %><span class="lb-avatar lb-avatar-blank"></span><% } %>
            <div class="lb-main">
              <div class="lb-name<%= m.left ? ' muted' : '' %>"><%= m.name %></div>
              <% if (m.level !== null) { %><div class="lb-bar"><span style="width:<%= m.pct %>%"></span></div><% } %>
            </div>
            <div class="lb-stats">
              <% if (m.level !== null) { %><span class="lb-level">Level <%= m.level %></span><% } %>
              <span class="muted small"><%= m.xp.toLocaleString('en') %> XP · <%= m.messages.toLocaleString('en') %> msgs</span>
              <% if (m.voiceXp > 0) { %>
                <span class="muted small"><%= m.voiceXp.toLocaleString('en') %> voice XP<% if (m.voiceMinutes > 0) { %> · <%= hm(m.voiceMinutes) %><% } %></span>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ol>

      <% if (pages > 1) { %>
        <% var pageHref = function (n) { return pq(lbPeriod) + (lbPeriod === 'all' ? 'page=' : '&page=') + n; }; %>
        <nav class="lb-pager">
          <% if (page > 1) { %><a href="<%= pageHref(page - 1) %>">&larr; Prev</a><% } else { %><span class="lb-pager-off">&larr; Prev</span><% } %>
          <span class="muted">Page <%= page %> of <%= pages %></span>
          <% if (page < pages) { %><a href="<%= pageHref(page + 1) %>">Next &rarr;</a><% } else { %><span class="lb-pager-off">Next &rarr;</span><% } %>
        </nav>
      <% } %>
    <% } %>

    <p class="lb-foot muted small">Powered by Sylo</p>
  </main>
</body>
</html>
