<% var list = typeof reminders !== 'undefined' ? reminders : []; %>
<%
  function humanInterval(min) {
    if (min % 10080 === 0) return 'every ' + (min / 10080) + 'w';
    if (min % 1440 === 0) return 'every ' + (min / 1440) + 'd';
    if (min % 60 === 0) return 'every ' + (min / 60) + 'h';
    return 'every ' + min + 'm';
  }
  function summary(r) {
    if (r.mode === 'single') {
      return r.runAt ? 'once · ' + new Date(r.runAt).toLocaleString() : 'once';
    }
    return humanInterval(r.intervalMinutes);
  }
%>

<p class="muted small">
  Post a text or embed message to a channel — once at a set time, or on a repeating schedule with an
  optional start/end window and a weekday filter. Role and <code>@everyone</code> mentions are allowed.
</p>

<div class="rr-list-head">
  <h3 class="u-m0">Your reminders <span class="muted small"><%= list.length %> / 100</span></h3>
  <a class="btn btn-primary" href="/guilds/<%= guild.id %>/m/reminders/r/new">＋ New reminder</a>
</div>

<% if (list.length === 0) { %>
  <p class="muted small">None yet — create one to post on a schedule.</p>
<% } else { %>
  <% list.forEach(function (r) { %>
    <div class="cmd-override">
      <div class="cmd-override-head">
        <span>
          <strong><%= r.name %></strong>
          <span class="muted small">· #<%= r.channel %> · <%= summary(r) %><% if (r.lastRun) { %> · last <%= r.lastRun %><% } %></span>
        </span>
        <span class="pill <%= r.enabled ? 'on' : 'off' %>"><%= r.enabled ? 'on' : 'off' %></span>
      </div>
      <div class="btn-row">
        <a class="plugin-btn" href="/guilds/<%= guild.id %>/m/reminders/r/<%= r.id %>">Edit</a>
        <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/m/reminders/r/<%= r.id %>/toggle">
          <button type="submit"><%= r.enabled ? 'Pause' : 'Resume' %></button>
        </form>
        <form class="u-inline" method="POST" action="/guilds/<%= guild.id %>/m/reminders/r/<%= r.id %>/delete">
          <button type="submit" class="danger" data-confirm="Delete this reminder?">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>
