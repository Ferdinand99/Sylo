<%
  var cfg = moduleConfig || {};
  var rewards = Array.isArray(cfg.rewards) ? cfg.rewards : [];
  var noXpC = Array.isArray(cfg.noXpChannels) ? cfg.noXpChannels : [];
  var noXpR = Array.isArray(cfg.noXpRoles) ? cfg.noXpRoles : [];
  var rates = (typeof xpRates !== 'undefined' && xpRates.length) ? xpRates : [0.25, 0.5, 0.75, 1, 1.5, 2, 2.5, 3];
  var board = levelingBoard || { total: 0, rows: [] };
  var chMode = cfg.noXpChannelsMode === 'deny' ? 'deny' : 'allow';
  var rMode = cfg.noXpRolesMode === 'deny' ? 'deny' : 'allow';
%>

<p class="muted small">
  Members earn 15–25 XP per message (scaled by the XP rate below), once per cooldown, on a MEE6-style curve.
  The public web leaderboard toggle is on the <a href="/guilds/<%= guild.id %>/leaderboard">Leaderboard</a> page.
</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/leveling/config" hx-post="/guilds/<%= guild.id %>/m/leveling/config" hx-target="#module-config" hx-swap="outerHTML">
  <details class="lvl-sec" open>
    <summary>Leveling up<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Whenever a member gains a level, Sylo can send a personalised message.</p>
    <label class="small">Level-up announcement</label>
    <select name="announce">
      <% announceModes.forEach(function (m) { %>
        <option value="<%= m %>" <%= m === (cfg.announce || 'channel') ? 'selected' : '' %>>
          <%= ({ channel: 'In a channel', reply: 'Reply to their message', dm: 'Direct message', off: 'No announcement' })[m] || m %>
        </option>
      <% }) %>
    </select>

    <label class="small u-mt-2">Announcement channel <span class="muted">— for "In a channel"; blank = wherever they levelled up</span></label>
    <select name="announceChannel">
      <option value="">— current channel —</option>
      <% channels.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= c.id === (cfg.announceChannel || '') ? 'selected' : '' %>>#<%= c.name %></option>
      <% }) %>
    </select>

    <label class="small u-mt-2">Level-up announcement message <span class="muted">— <code>{player}</code> <code>{level}</code> <code>{username}</code> <code>{server}</code></span></label>
    <textarea name="announceMessage" rows="3" maxlength="2000" id="lvl-msg" placeholder="GG {player}, you just advanced to level {level}!"><%= cfg.announceMessage || '' %></textarea>
    <div class="muted small u-text-right"><span id="lvl-msg-count">0</span> / 2000</div>

    <label class="small u-mt-2">XP cooldown (seconds)</label>
    <input class="u-w-field-sm" type="number" name="cooldownSeconds" min="0" max="3600" value="<%= cfg.cooldownSeconds != null ? cfg.cooldownSeconds : 60 %>" />
  </details>

  <details class="lvl-sec" open>
    <summary>Role rewards configuration<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Roles given automatically when a member reaches a level. Choose to stack them or keep only the highest.</p>

    <label class="rr-mode"><input type="radio" name="stackRewards" value="on" <%= cfg.stackRewards !== false ? 'checked' : '' %> /> <span><strong>Stack previous rewards</strong> — a member can hold several reward roles at once.</span></label>
    <label class="rr-mode"><input type="radio" name="stackRewards" value="" <%= cfg.stackRewards === false ? 'checked' : '' %> /> <span><strong>Remove previous rewards</strong> — a member only keeps the highest reward role.</span></label>

    <label class="small u-mt-2">Role rewards</label>
    <table class="thresholds">
      <thead><tr><th>At level</th><th>Give role</th><th></th></tr></thead>
      <tbody id="rw-rows">
        <% rewards.forEach(function (r) { %>
          <tr>
            <td><input class="u-w-num" type="number" name="rw_level" min="1" max="1000" value="<%= r.level %>" /></td>
            <td>
              <select name="rw_role">
                <% roles.forEach(function (role) { %><option value="<%= role.id %>" <%= role.id === r.roleId ? 'selected' : '' %>><%= role.name %></option><% }) %>
              </select>
            </td>
            <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div><button type="button" class="secondary" id="rw-add">＋ Add role reward</button></div>

    <label class="checkline u-mt-3">
      <input type="checkbox" name="removeRewardsOnXpLoss" <%= cfg.removeRewardsOnXpLoss ? 'checked' : '' %> />
      Remove a reward role when a member drops below its level (e.g. after Set XP / reset)
    </label>
  </details>

  <details class="lvl-sec" open>
    <summary>XP rate<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Scale how fast members gain XP.</p>
    <div class="xp-rate">
      <% rates.forEach(function (x) { %>
        <label class="<%= Number(cfg.xpRate || 1) === x ? 'on' : '' %>">
          <input type="radio" name="xpRate" value="<%= x %>" <%= Number(cfg.xpRate || 1) === x ? 'checked' : '' %> /> x<%= x %>
        </label>
      <% }) %>
    </div>
  </details>

  <details class="lvl-sec" open>
    <summary>No-XP roles<span class="lvl-chev">▾</span></summary>
    <label class="rr-mode"><input type="radio" name="noXpRolesMode" value="allow" <%= rMode === 'allow' ? 'checked' : '' %> /> <span><strong>Allow all roles to gain XP, except</strong> the ones below</span></label>
    <label class="rr-mode"><input type="radio" name="noXpRolesMode" value="deny" <%= rMode === 'deny' ? 'checked' : '' %> /> <span><strong>Deny all roles from gaining XP, except</strong> the ones below</span></label>
    <%- include('../../partials/chip-picker', { field: 'noXpRoles', kind: 'role', items: roles, selected: noXpR }) %>
  </details>

  <details class="lvl-sec" open>
    <summary>No-XP channels<span class="lvl-chev">▾</span></summary>
    <label class="rr-mode"><input type="radio" name="noXpChannelsMode" value="allow" <%= chMode === 'allow' ? 'checked' : '' %> /> <span><strong>Allow all channels to gain XP, except</strong> the ones below</span></label>
    <label class="rr-mode"><input type="radio" name="noXpChannelsMode" value="deny" <%= chMode === 'deny' ? 'checked' : '' %> /> <span><strong>Deny all channels from gaining XP, except</strong> the ones below</span></label>
    <%- include('../../partials/chip-picker', { field: 'noXpChannels', kind: 'channel', items: channels, selected: noXpC }) %>
  </details>

  <div class="u-mt-4"><button type="submit">Save leveling settings</button></div>
</form>

<% if (typeof levelingCommands !== 'undefined' && levelingCommands.length) { %>
  <details class="lvl-sec u-mt-4" open>
    <summary>Commands<span class="lvl-chev">▾</span></summary>
    <%- include('../commands', { guild: guild, commands: levelingCommands, roles: roles, channels: channels }) %>
  </details>
<% } %>

<hr class="sep" />

<h3 class="u-mb-1">Leaderboard preview <span class="muted small">(<%= board.total %> tracked)</span></h3>
<% if (board.rows.length === 0) { %>
  <p class="muted">No XP earned yet.</p>
<% } else { %>
  <table>
    <thead><tr><th>#</th><th>Member</th><th class="num">Level</th><th class="num">XP</th><th class="num">Messages</th></tr></thead>
    <tbody>
      <% board.rows.forEach(function (r) { %>
        <tr>
          <td><%= r.rank %></td>
          <td class="mono">&lt;@<%= r.userId %>&gt;</td>
          <td class="num"><%= r.level %></td>
          <td class="num"><%= r.xp %></td>
          <td class="num"><%= r.messages %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<form method="POST" action="/guilds/<%= guild.id %>/m/leveling/xp" class="row-form u-mt-3">
  <label class="small">Set XP for user</label>
  <input class="u-w-field" type="text" name="userId" placeholder="user ID or @mention" />
  <input class="u-w-field-sm" type="number" name="xp" min="0" placeholder="xp" />
  <button type="submit">Update</button>
  <button type="submit" name="reset" value="true" class="secondary" data-confirm="Wipe ALL leveling data for this server?">Reset all</button>
</form>

<template id="rw-template">
  <tr>
    <td><input class="u-w-num" type="number" name="rw_level" min="1" max="1000" value="5" /></td>
    <td>
      <select name="rw_role">
        <% roles.forEach(function (role) { %><option value="<%= role.id %>"><%= role.name %></option><% }) %>
      </select>
    </td>
    <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
  </tr>
</template>
<script>
  document.getElementById('rw-add')?.addEventListener('click', () => {
    document.getElementById('rw-rows').appendChild(document.getElementById('rw-template').content.cloneNode(true));
  });
  (function () {
    var ta = document.getElementById('lvl-msg'), c = document.getElementById('lvl-msg-count');
    if (!ta || !c) return;
    var upd = function () { c.textContent = ta.value.length; };
    ta.addEventListener('input', upd); upd();
  })();
  document.querySelectorAll('.xp-rate input').forEach(function (r) {
    r.addEventListener('change', function () {
      document.querySelectorAll('.xp-rate label').forEach(function (l) { l.classList.remove('on'); });
      if (r.checked) r.closest('label').classList.add('on');
    });
  });
</script>
